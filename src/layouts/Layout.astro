---
import "../styles/global.css";

import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width" />
      <title>{title}</title>
      <meta name="description" content={description} />

      <!-- Favicon -->
      <link
         rel="icon"
         type="image/png"
         href="/favicon-32x32.png"
         sizes="32x32"
      />
      <link
         rel="icon"
         type="image/png"
         href="/favicon-96x96.png"
         sizes="96x96"
      />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="shortcut icon" href="/favicon.ico" />
      <link
         rel="apple-touch-icon"
         sizes="180x180"
         href="/apple-touch-icon.png"
      />
      <meta name="apple-mobile-web-app-title" content="Santiago Goncalvez" />
      <link rel="manifest" href="/site.webmanifest" />

      <style is:global>
         @font-face {
            font-family: "Satoshi Variable";
            src: url("/Satoshi-Variable.woff2") format("woff2");
            font-display: swap;
         }

         :root {
            color-scheme: light dark;
         }

         html {
            font-family:
               "Satoshi Variable",
               system-ui,
               -apple-system,
               BlinkMacSystemFont,
               sans-serif;
            scroll-behavior: smooth;
         }

         body {
            margin: 0;
            min-height: 100vh;
         }

         @media (prefers-reduced-motion: reduce) {
            html {
               scroll-behavior: auto;
            }
         }
      </style>

      <slot name="head" />

      <meta name="generator" content={Astro.generator} />

      <link rel="canonical" href="https://santiagogoncalvez.com" />

      <meta property="og:type" content="website" />
      <meta property="og:locale" content="es_AR" />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content="https://santiagogoncalvez.com" />
      <meta
         property="og:image"
         content="https://santiagogoncalvez.com/og.png"
      />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={description} />

      <meta property="og:site_name" content="Santiago Goncalvez" />

      <!-- Twitter Card -->
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta
         name="twitter:image"
         content="https://santiagogoncalvez.com/og.png"
      />

      <meta
         name="google-site-verification"
         content="W3Lp3GsRg9PNa6c8hQ_83vaBqEHlKQrae7YLXjDRMZ0"
      />

      <script type="application/ld+json">
         {
            "@context": "https://schema.org",
            "@type": "LocalBusiness",
            "name": "Santiago Goncalvez | Páginas que convierten",
            "image": "https://santiagogoncalvez.com/santiago-goncalvez-estratega-digital-react-astro.webp",
            "@id": "https://santiagogoncalvez.com/",
            "url": "https://santiagogoncalvez.com/",
            "telephone": "+5491135821266",
            "priceRange": "$$",
            "description": "Desarrollador web especializado en plataformas de alta velocidad en Buenos Aires. Transformo visitas en clientes mediante sitios web modernos, rápidos y optimizados para Google.",
            "address": {
               "@type": "PostalAddress",
               "addressLocality": "Buenos Aires",
               "addressCountry": "AR"
            },
            "knowsAbout": [
               "Desarrollo Web de Alta Velocidad",
               "Astro Framework",
               "React.js",
               "Conversión de Clientes",
               "SEO Técnico",
               "Diseño de Interfaces Modernas"
            ],
            "hasOfferCatalog": {
               "@type": "OfferCatalog",
               "name": "Servicios de Desarrollo Web",
               "itemListElement": [
                  {
                     "@type": "Offer",
                     "itemOffered": {
                        "@type": "Service",
                        "name": "Landing Pages de Alta Conversión",
                        "description": "Sitios diseñados para una sola misión: vender. Carga instantánea para evitar la pérdida de clientes."
                     }
                  },
                  {
                     "@type": "Offer",
                     "itemOffered": {
                        "@type": "Service",
                        "name": "Sitios Institucionales Premium",
                        "description": "Presencia digital robusta con estética editorial para marcas que buscan proyectar autoridad y confianza."
                     }
                  },
                  {
                     "@type": "Offer",
                     "itemOffered": {
                        "@type": "Service",
                        "name": "Plataformas Autogestionables",
                        "description": "Sistemas a medida para gestionar contenido de forma fácil y segura sin depender de un programador."
                     }
                  }
               ]
            },
            "sameAs": [
               "https://www.linkedin.com/in/santiagogoncalvez",
               "https://wa.me/5491135821266"
            ]
         }
      </script>
   </head>

   <body class="relative min-h-screen bg-title dark:bg-bg-base">
      <!-- <GradientBackground /> -->

      <div class="relative flex flex-col items-center min-h-screen w-full">
         <Header />
         <slot />
         <Footer />
      </div>
   </body>
</html>
