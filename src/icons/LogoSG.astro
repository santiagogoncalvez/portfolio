---
interface Props {
   class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
   viewBox="0 0 120 120"
   xmlns="http://www.w3.org/2000/svg"
   role="img"
   aria-label="SG Logo"
   fill="none"
   stroke="currentColor"
   stroke-width="2"
   stroke-linecap="round"
   stroke-linejoin="round"
   {...Astro.props}
>
   <text
      x="60"
      y="60"
      text-anchor="middle"
      dominant-baseline="middle"
      fill="currentColor"
      font-family="Onest, system-ui, sans-serif"
      font-size="48"
      font-weight="600"
      letter-spacing="0.04em"
   >
      SG
   </text>
</svg>
