---
import Layout from "../layouts/Layout.astro";

import SectionContainer from "../components/shared/SectionContainer.astro";
import Projects from "../components/sections/Projects/Projects.astro";
import AboutMe from "../components/sections/AboutMe.astro";

import Formation from "../components/sections/Formation.astro";
import Hero from "../components/sections/Hero/Hero.astro";
import Services from "@/components/sections/Services.astro";
import Contact from "@/components/sections/Contact.astro";
import Technologies from "@/components/sections/Technologies.astro";
---

<Layout
   title="Santiago Goncalvez | Desarrollo Web & Sistemas a Medida"
   description="Potenciá tu negocio con sitios web de alto rendimiento. Especialista en React y Astro para crear interfaces rápidas, modernas y escalables a medida."
>
   <main
      class="w-full md:pt-26 sm:pt-24 pt-22 px-5 flex flex-col sm:gap-24 gap-16"
   >
      <SectionContainer>
         <Hero />
      </SectionContainer>

      <SectionContainer id="tecnologías">
         <Technologies />
      </SectionContainer>

      <SectionContainer id="soluciones">
         <Services />
      </SectionContainer>

      <SectionContainer id="proyectos">
         <Projects />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
         <AboutMe />
      </SectionContainer>

      <SectionContainer id="contacto">
         <Contact />
      </SectionContainer>
   </main>

   <!-- <KeyboardManager /> -->
</Layout>
