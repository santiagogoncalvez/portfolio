---
import Layout from "../layouts/Layout.astro";

import SectionContainer from "../components/shared/SectionContainer.astro";
import Projects from "../components/sections/Projects/Projects.astro";
import AboutMe from "../components/sections/AboutMe.astro";

import Hero from "../components/sections/Hero/Hero.astro";
import Services from "@/components/sections/Services.astro";
import Contact from "@/components/sections/Contact.astro";
import Technologies from "@/components/sections/Technologies.astro";
import Testimonies from "@/components/sections/Testimonies.astro";
import Process from "@/components/sections/Process.astro";
import Main from "@/components/shared/Main.astro";
---

<Layout
   title="Santiago Goncalvez | Sitios Web que Conversión y Resultados"
   description="Transformo tu visión en una web profesional que refleja tu esencia. Diseño y tecnología de alto rendimiento para impulsar tu proyecto al siguiente nivel."
>
   <Main>
      <SectionContainer>
         <Hero />
      </SectionContainer>
      
      <SectionContainer id="soluciones">
         <Services />
      </SectionContainer>

      <SectionContainer id="mi-proceso">
         <Process />
      </SectionContainer>

      <SectionContainer id="proyectos">
         <Projects />
      </SectionContainer>

      <SectionContainer id="testimonios">
         <Testimonies />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
         <AboutMe />
      </SectionContainer>

      <SectionContainer id="contacto">
         <Contact />
      </SectionContainer>
   </Main>

   <!-- <KeyboardManager /> -->
</Layout>
