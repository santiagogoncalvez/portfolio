---
import Subtitle from "@shared/Subtitle.astro";
import PlayIcon from "@icons/Play.astro";
import ProcessIcon from "@icons/Process.astro";
import CloseIcon from "@icons/Close.astro";
import Card from "../shared/Card/Card.astro";
import Paragraph from "../shared/Paragraph.astro";

interface Step {
   title: string;
   description: string;
   variant?:
      | "transparent"
      | "highlight"
      | "transparentLeft"
      | "transparentMiddle"
      | "transparentRight"
      | "none";
}

const STEPS: Step[] = [
   {
      title: "Estrategia",
      description:
         "Analizo tu negocio para diseñar una estrategia real. El objetivo es que tu web trabaje para vos.",
      variant: "none",
   },
   {
      title: "Desarrollo",
      description:
         "Construyo tu sitio con tecnología moderna para que tu web vuele, priorizando la velocidad.",
      variant: "none",
   },
   {
      title: "Control Total",
      description:
         "Te entrego el proyecto desplegado y el control de tu contenido para que puedas escalar.",
      variant: "none",
   },
];

const VIDEO_PREVIEW =
   "/video/santiago-goncalvez-estratega-digital-hero-preview.mp4";
const VIDEO_FULL =
   "/video/estrategia-desarrollo-web-alto-rendimiento-santiago-goncalvez.mp4";
---

<div class="flex flex-row justify-between items-end flex-wrap gap-4">
   <Subtitle> Mi proceso </Subtitle>

   <p class="text-border-strong dark:text-text">De la idea al resultado</p>
</div>

<div class="flex flex-col md:flex-row gap-8 items-stretch" id="process-section">
   <!-- Video -->
   <div
      class="process-animate-item w-full md:flex-1 min-w-0 opacity-0"
      id="video-trigger"
   >
      <div
         class="relative overflow-hidden rounded-2xl aspect-video bg-bg-deep/50"
      >
         <video
            src={VIDEO_PREVIEW}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            class="w-full h-full object-cover"></video>

         <div class="absolute inset-0 flex items-center justify-center">
            <div
               class="dark:bg-title bg-bg-deep sm:p-5 p-3 rounded-full
                      group-hover:scale-110 transition-transform duration-300"
            >
               <div class="dark:text-bg-deep text-title">
                  <PlayIcon class="sm:size-6 size-4" />
               </div>
            </div>
         </div>
      </div>
   </div>

   <!-- Proceso -->
   <div
      class="process-animate-item w-full md:flex-1 min-w-0 md:aspect-video opacity-0"
   >
      <div class="md:h-full h-fit flex flex-col gap-8 justify-center">
         {
            STEPS.map((step) => (
               <article class=" flex flex-col justify-center">
                  <h3 class="text-bg-elevated dark:text-title font-medium text-xl">
                     {step.title}
                  </h3>

                  <p class="mt-4 text-sm leading-relaxed text-border-strong dark:text-text">
                     {step.description}
                  </p>
               </article>
            ))
         }
      </div>
   </div>
</div>

<dialog
   id="video-modal"
   class="fixed inset-0 z-50 backdrop:backdrop-blur-md bg-transparent p-0 rounded-2xl border-none max-w-4xl w-[95%] outline-none overflow-visible open:flex items-center justify-center m-auto"
>
   <div class="relative w-full">
      <button
         id="close-modal"
         class="absolute -top-12 right-0 text-white text-xs font-semibold bg-white/10 hover:bg-white/20 px-2 py-2 rounded-full transition-colors hover:cursor-pointer"
      >
         <CloseIcon class="size-6" />
      </button>
      <video
         id="main-video"
         controls
         class="w-full rounded-2xl shadow-2xl"
         preload="auto"
      >
         <source src={VIDEO_FULL} type="video/mp4" />
      </video>
   </div>
</dialog>

<script>
   import { animate, stagger, inView } from "motion";

   const threshold = window.innerWidth >= 640 ? 0.05 : 0.02;

   inView(
      "#process-section",
      () => {
         animate(
            ".process-animate-item",
            { opacity: [0, 1], y: [15, 0] },
            {
               delay: stagger(0.06),
               duration: 0.3,
               ease: [0.33, 1, 0.68, 1],
            },
         );
      },
      { amount: threshold },
   );
</script>

<script>
   import { animate } from "motion";

   // Lógica de Modal (Sin cambios)
   const modal = document.getElementById("video-modal") as HTMLDialogElement;
   const trigger = document.getElementById("video-trigger");
   const closeBtn = document.getElementById("close-modal");
   const mainVideo = document.getElementById("main-video") as HTMLVideoElement;

   trigger?.addEventListener("click", () => {
      modal.showModal();
      mainVideo.play();
      animate(modal, { opacity: [0, 1], scale: [0.95, 1] }, { duration: 0.3 });
   });

   const closeModal = () => {
      mainVideo.pause();
      modal.close();
   };

   closeBtn?.addEventListener("click", closeModal);
   modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
   });
</script>

<style>
   dialog:not([open]) {
      display: none !important;
   }
   dialog::backdrop {
      background: rgba(0, 0, 0, 0.9);
   }
   :root:has(dialog[open]) {
      overflow: hidden;
   }
</style>
