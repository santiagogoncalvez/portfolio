---
import UniversityIcon from "@icons/University.astro";
import ReactIcon from "@icons/React.astro";
import BookIcon from "@icons/Book.astro";
import JavaScriptIcon from "@icons/JavaScript.astro";
import Subtitle from "../shared/Subtitle.astro";

interface BentoItem {
   title: string;
   subtitle: string;
   description?: string;
   icon?: any;
   class?: string;
   tags?: string[];
}

const formationItems: BentoItem[] = [
   {
      title: "Ingeniería Informática",
      subtitle: "Universidad (En curso)",
      description:
         "Enfoque en resolución de problemas complejos, lógica algorítmica y sistemas de bajo nivel.",
      icon: UniversityIcon,
      class: "md:col-span-2 md:row-span-2",
      tags: ["C", "Estructuras", "Sistemas Embebidos", "Matemática"],
   },
   {
      title: "Especialización React",
      subtitle: "Midudev",
      description:
         "Desarrollo de aplicaciones modernas con Hooks, patrones de estado y optimización.",
      icon: ReactIcon,
      class: "md:col-span-2 border-l-2 border-l-border-strong/10 dark:border-l-border-subtle",
   },
   {
      title: "The Road to React",
      subtitle: "Robin Wieruch",
      description:
         "Arquitectura de componentes y gestión de datos en el ecosistema React.",
      icon: BookIcon,
      class: "md:col-span-1",
   },
   {
      title: "Eloquent JavaScript",
      subtitle: "M. Haverbeke",
      description:
         "Inmersión profunda en la naturaleza funcional y asíncrona de JavaScript.",
      icon: JavaScriptIcon,
      class: "md:col-span-1",
   },
];
---

<Subtitle class="flex flex-row items-center gap-x-4">
   <BookIcon
      class="sm:size-8 size-7 text-border-strong dark:text-text-highlighted"
   />
   <span>Formación</span>
</Subtitle>

<div
   id="formation-container"
   class="grid grid-cols-1 md:grid-cols-4 gap-4 auto-rows-[minmax(180px,auto)]"
>
   {
      formationItems.map((item) => {
         const IconComponent = item.icon;

         return (
            <article
               class={`
                     formation-item opacity-0
                     group relative overflow-hidden p-6 flex flex-col 
                     bg-white/80 dark:bg-transparent border border-black/5 dark:border-border-subtle rounded-lg
                     shadow-sm hover:shadow-md
                     
                     /* Transiciones específicas para no romper el 'y' de la entrada */
                     transition-[box-shadow,border-color,background-color] duration-500 ease-out
                     hover:scale-[1.01] hover:transition-transform
                     hover:border-border-strong/20 dark:hover:border-text-highlighted/30
                     ${item.class || ""}
                  `}
            >
               <div class="absolute top-0 right-0 -mr-10 -mt-10 w-32 h-32 rounded-full bg-text-muted/5 dark:bg-white/5 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700" />

               <div class="relative w-full">
                  <div class="flex items-center justify-between mb-3">
                     <span class="text-[10px] font-bold uppercase tracking-widest text-text-muted dark:text-text-highlighted border border-border-strong/10 dark:border-border-subtle px-4 py-1.5 rounded-full bg-bg-deep/5 dark:bg-bg-base">
                        {item.subtitle}
                     </span>

                     {item.icon && (
                        <div class="flex justify-center items-center size-8 text-text-dimmed dark:text-text-muted group-hover:text-bg-deep dark:group-hover:text-title transition-colors">
                           <IconComponent class="stroke-1" />
                        </div>
                     )}
                  </div>
               </div>

               <div class="relative flex-grow flex flex-col justify-center">
                  <h3 class="text-xl md:text-2xl font-bold text-bg-deep dark:text-title leading-tight">
                     {item.title}
                  </h3>

                  {item.description && (
                     <p class="text-border-strong dark:text-text mt-3 leading-relaxed opacity-90">
                        {item.description}
                     </p>
                  )}

                  {item.tags && (
                     <div class="flex flex-wrap gap-2 mt-5">
                        {item.tags.map((tag) => (
                           <span class="text-sm font-medium px-2 py-1 rounded-md border border-border-strong/8 dark:border-border-subtle text-text-muted dark:text-text-light">
                              {tag}
                           </span>
                        ))}
                     </div>
                  )}
               </div>

               {item.class?.includes("row-span-2") && (
                  <div class="relative mt-6 pt-4 border-t border-border-strong/10 dark:border-white/5 sm:opacity-80 opacity-100 group-hover:opacity-100 transition-opacity">
                     <span class="text-xs font-medium uppercase tracking-[0.2em] text-border-strong dark:text-text">
                        Sistemas · Algoritmos · Lógica
                     </span>
                  </div>
               )}
            </article>
         );
      })
   }
</div>

<script>
   import { animate, stagger, inView } from "motion";

   const threshold = window.innerWidth >= 640 ? 0.05 : 0.02;

   inView(
      "#formation-container",
      () => {
         animate(
            ".formation-item",
            {
               opacity: [0, 1],
               y: [15, 0],
            },
            {
               delay: stagger(0.01),
               duration: 0.2,
               easing: [0.22, 1, 0.36, 1],
            },
         );
      },
      { amount: threshold },
   );
</script>
