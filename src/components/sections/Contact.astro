import LinkButton from "@shared/LinkButton.astro";
import CtaButton from "../shared/CtaButton.astro";
import CtaButtonInner from "../shared/CtaButtonInner.astro";

// Nota: Podés importar tus iconos de Mail, LinkedIn o WhatsApp aquí
---

<section class="">
