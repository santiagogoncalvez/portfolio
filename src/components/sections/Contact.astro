---
import CtaButton from "../shared/CtaButton.astro";
import CtaButtonInner from "../shared/CtaButtonInner.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import WhatsApp from "@/icons/WhatsApp.astro";
---

<div class="w-full pb-">
   <div
      id="contact-card"
      class="contact-element opacity-0 group relative overflow-hidden rounded-2xl border border-border-card-outline dark:border-white/10
             bg-white dark:bg-bg-deep
             p-8 md:p-20 text-center
             shadow-[0_20px_50px_rgba(0,0,0,0.05)] dark:shadow-none
             /* Transiciones específicas para no chocar con Motion */
             transition-[border-color,background-color] duration-500
             hover:border-border-strong/15
             dark:hover:border-text-highlighted/20"
   >
      {/* 1. EL EFECTO SPOTLIGHT REFINADO */}
      <div
         class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100 z-0"
      >
         <div
            class="absolute inset-0 dark:hidden"
            style="background: radial-gradient(350px circle at var(--mouse-x) var(--mouse-y), rgba(0, 0, 0, 0.05), transparent 80%);"
         >
         </div>
         <div
            class="absolute inset-0 hidden dark:block"
            style="background: radial-gradient(350px circle at var(--mouse-x) var(--mouse-y), rgba(255, 255, 255, 0.04), transparent 80%);"
         >
         </div>
      </div>

      {/* 2. Desenfoques de fondo */}
      <div
         class="absolute -top-24 -left-24 size-96 rounded-full bg-text-highlighted/[0.08] dark:bg-text-highlighted/5 blur-[100px] pointer-events-none z-0"
      >
      </div>
      <div
         class="absolute -bottom-24 -right-24 size-96 rounded-full bg-bg-deep/[0.03] dark:bg-white/5 blur-[100px] pointer-events-none z-0"
      >
      </div>

      {/* 3. Contenido de la Card */}
      <div
         class="relative flex flex-col sm:gap-8 gap-6 max-w-2xl mx-auto z-1 pointer-events-auto"
      >
         <div class="flex flex-col sm:gap-6 gap-4">
            <h2
               class="contact-content opacity-0 text-3xl md:text-5xl font-bold text-bg-deep dark:text-title tracking-tighter text-balance"
            >
               ¿Llevamos tu marca al siguiente nivel?
            </h2>

            <p
               class="contact-content opacity-0 md:text-lg text-base text-border-strong dark:text-text leading-relaxed text-balance"
            >
               Ayudo a profesionales a crear webs que reflejan su esencia.
               Tecnología y diseño a la altura de tu trabajo, impulsando tu
               proyecto hacia adelante.
            </p>
         </div>

         <div
            class="contact-content opacity-0 flex flex-col items-center justify-center gap-4"
         >
            <CtaButton
               class="rounded-full px-6 py-2.5 md:text-lg text-base"
               isChatIntent
            >
               <WhatsApp class="min-h-full min-w-auto" />
               Agendar una charla
            </CtaButton>
         </div>
      </div>
   </div>
</div>

<script>
   import { animate, stagger, inView } from "motion";

   const threshold = window.innerWidth >= 640 ? 0.05 : 0.02;

   function initContactAnimations() {
      // 1. Animación del contenedor principal (Scale + Fade)
      inView(
         "#contact-card",
         () => {
            animate(
               "#contact-card",
               {
                  opacity: [0, 1],
                  scale: [0.98, 1],
                  y: [20, 0],
               },
               { duration: 0.4, easing: [0.22, 1, 0.36, 1] },
            );

            // 2. Animación del contenido interno (Cascada)
            animate(
               ".contact-content",
               { opacity: [0, 1], y: [10, 0] },
               { delay: stagger(0.05), duration: 0.25 },
            );
         },
         { amount: threshold },
      );

      // 3. Lógica de Spotlight (Tu código original)
      const card = document.getElementById("contact-card");
      if (!card) return;
      card.addEventListener("mousemove", (e) => {
         const rect = card.getBoundingClientRect();
         const x = e.clientX - rect.left;
         const y = e.clientY - rect.top;
         card.style.setProperty("--mouse-x", `${x}px`);
         card.style.setProperty("--mouse-y", `${y}px`);
      });
   }

   initContactAnimations();
   document.addEventListener("astro:page-load", initContactAnimations);
</script>
