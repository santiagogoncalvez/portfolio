   <div
      class="relative overflow-hidden rounded-xl border border-black/5 dark:border-border-subtle bg-white/50 dark:bg-bg-surface p-8 md:p-20 text-center"
   >
      {/* Efecto de luz de fondo sutil */}
      <div
         class="absolute -top-24 -left-24 size-64 rounded-full bg-text-highlighted/5 blur-3xl pointer-events-none"
      >
      </div>
      <div
         class="absolute -bottom-24 -right-24 size-64 rounded-full bg-bg-deep/5 dark:bg-white/5 blur-3xl pointer-events-none"
      >
      </div>

      <div class="relative max-w-2xl mx-auto space-y-6">
         <h3
            class="text-3xl md:text-5xl font-bold text-bg-deep dark:text-title tracking-tight text-pretty"
         >
            ¿Tenés un proyecto en mente?
         </h3>

         <p class="text-lg text-text-muted dark:text-text leading-relaxed">
            Busco colaborar con marcas y profesionales que necesiten soluciones
            digitales escalables y de alto rendimiento. Si buscás transformar
            una idea en una interfaz real y eficiente, hablemos.
         </p>

         <div
            class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4"
         >
            <CtaButton class="rounded-full px-6 py-2.5 text-lg"
               >Agendar una charla</CtaButton
            >

            <CtaButtonInner>Linkedin</CtaButtonInner>
         </div>

         <div class="pt-8 flex flex-col items-center gap-2">
            <div class="flex items-center gap-x-2">
               <span class="relative flex h-2 w-2">
                  <span
                     class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                  ></span>
                  <span
                     class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
                  ></span>
               </span>
               <p class="text-xs uppercase tracking-[0.2em] text-text-muted">
                  Respuesta promedio: Menos de 24hs
               </p>
            </div>
         </div>
      </div>
   </div>
</section>
