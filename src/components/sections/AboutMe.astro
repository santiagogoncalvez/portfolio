---
import ProfileCheckIcon from "@icons/ProfileCheck.astro";
import Subtitle from "../shared/Subtitle.astro";
import profilePic from "../../assets/santiago-goncalvez-front-face-casual.webp";

const personalImageAlt =
   "Retrato casual de Santiago Goncalvez - Desarrollador Web";

import { Image } from "astro:assets";
---

<Subtitle class="flex flex-row items-center gap-x-4">
   <ProfileCheckIcon
      class="size-7 text-border-strong dark:text-text-highlighted"
   />
   <span>Sobre mí</span>
</Subtitle>

<article class="flex flex-col md:flex-row gap-6 items-stretch">
   <div
      class="md:w-2/3 p-8 rounded-xl bg-white/50 dark:bg-bg-surface border border-black/5 dark:border-border-subtle flex flex-col justify-center"
   >
      <div class="space-y-4 text-border-strong dark:text-text leading-relaxed">
         <div
            class="space-y-4 text-border-strong dark:text-text leading-relaxed"
         >
            <p>
               Estudiante de <strong
                  class="text-bg-deep dark:text-text-highlighted"
                  >Ingeniería Informática</strong
               > enfocado en el ecosistema <strong>React</strong>. Fusiono el
               rigor analítico de la carrera con la construcción de interfaces
               modernas, priorizando arquitecturas limpias y una experiencia de
               usuario optimizada.
            </p>

            <p>
               Especializado en transformar problemas lógicos en <strong
                  >interfaces escalables</strong
               >, cuidando tanto la integridad del código interno como la
               fluidez visual que percibe el usuario final.
            </p>

            <footer
               class="pt-4 border-t border-black/5 dark:border-white/5 flex flex-wrap items-center justify-between gap-4"
            >
               <div class="flex items-center gap-x-2">
                  <div
                     class="size-2 rounded-full bg-bg-deep/20 dark:bg-text-highlighted/20 border border-bg-deep/10 dark:border-white/10"
                  >
                  </div>
                  <span
                     class="text-xs font-medium uppercase tracking-widest text-border-strong/90 dark:text-text/80"
                  >
                     Foco: Arquitecturas Escalables
                  </span>
               </div>

               <span
                  class="text-xs font-medium uppercase tracking-widest text-border-strong/90 dark:text-text/80"
               >
                  Buenos Aires, AR
               </span>
            </footer>
         </div>
      </div>
   </div>

   <div class="md:w-1/3 relative group">
      <div
         class="h-full w-full overflow-hidden rounded-xl border border-black/5 dark:border-border-subtle shadow-sm"
      >
         <Image
            src={profilePic}
            alt={personalImageAlt}
            class="w-full h-full object-cover"
         />
      </div>
   </div>
</article>
