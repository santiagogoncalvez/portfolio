---
import ProfileCheckIcon from "@icons/ProfileCheck.astro";
import Subtitle from "../shared/Subtitle.astro";
import Paragraph from "../shared/Paragraph.astro";

import profilePic from "@assets/santiago-goncalvez-desarrollo-web-boutique-buenos-aires.webp";

const personalImageAlt =
   "Retrato casual de Santiago Goncalvez - Desarrollador Web";

import { Image } from "astro:assets";
import Card from "../shared/Card/Card.astro";
---

<Subtitle class="flex flex-row items-center gap-x-4">
   <ProfileCheckIcon
      class="sm:size-8 size-7 text-border-strong dark:text-text-highlighted"
   />
   <span>Sobre mí</span>
</Subtitle>

<div id="about-container" class="flex flex-col md:flex-row gap-6 items-stretch">
   <Card variant="transparent" class="about-item opacity-0 md:w-2/3 min-h-full">
      <Paragraph>
         <p>
            Soy Santiago, y creo que una web profesional debe ser el motor de tu
            negocio.
         </p>

         <p>
            Me especializo en transformar ideas en interfaces de alto
            rendimiento con React y Astro. Mi enfoque combina un diseño moderno
            con la velocidad que tus clientes exigen hoy. Mi objetivo es simple:
            que tu marca proyecte la autoridad que merece desde el primer
            segundo.
         </p>

         <p>
            <strong class="font-semibold"
               >Me encargo de la tecnología, vos te encargás de escalar</strong
            >.
         </p>
      </Paragraph>

      {/* El Footer como Slot Nombrado (Seguro y flexible) */}
      <div slot="footer" class="w-full flex justify-between flex-wrap gap-2">
         <div class="flex flex-row gap-2 items-center">
            <div class="bg-green-500 size-2 rounded-full"></div>

            <p>Disponible</p>
         </div>
         <p>Buenos Aires, Argentina</p>
      </div>
   </Card>

   <div class="about-item opacity-0 md:w-1/3 relative group">
      <div
         class="h-full w-full overflow-hidden rounded-2xl shadow-sm bg-bg-deep/5 transition-transform duration-500 ease-out group-hover:scale-[1.02]"
      >
         <Image
            src={profilePic}
            alt={personalImageAlt}
            class="w-full h-full object-cover"
         />
      </div>
   </div>

   <script>
      import { animate, stagger, inView } from "motion";

      const threshold = window.innerWidth >= 640 ? 0.05 : 0.02;

      inView(
         "#about-container",
         () => {
            animate(
               ".about-item",
               { opacity: [0, 1], y: [15, 0] },
               {
                  delay: stagger(0.06),
                  duration: 0.3,
                  easing: [0.33, 1, 0.68, 1],
               },
            );
         },
         { amount: threshold },
      );
   </script>
</div>
