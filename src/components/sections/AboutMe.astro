---
import ProfileCheckIcon from "@icons/ProfileCheck.astro";
import Subtitle from "../shared/Subtitle.astro";
import profilePic from "../../assets/santiago-goncalvez-front-face-casual.webp";

const personalImageAlt =
   "Retrato casual de Santiago Goncalvez - Desarrollador Web";

import { Image } from "astro:assets";
---

<Subtitle class="flex flex-row items-center gap-x-4">
   <ProfileCheckIcon
      class="size-7 text-border-strong dark:text-text-highlighted"
   />
   <span>Sobre mí</span>
</Subtitle>

<div class="flex flex-col md:flex-row gap-6 items-stretch">
   <div
      class="md:w-2/3 p-8 rounded-xl bg-white/50 dark:bg-bg-surface border border-black/5 dark:border-border-subtle flex flex-col justify-center"
   >
      <div class="space-y-5 text-border-strong dark:text-text leading-relaxed">
         <p>
            Combino el rigor de la <strong
               class="text-bg-deep dark:text-text-highlighted"
               >Ingeniería Informática</strong
            > con la agilidad de <strong
               class="text-bg-deep dark:text-text-highlighted"
               >React y Astro</strong
            > para crear productos digitales que no solo se ven bien, sino que rinden
            al máximo.
         </p>

         <p>
            Mi enfoque es simple: resolver problemas técnicos con <strong
               class="text-bg-deep dark:text-text-highlighted"
               >interfaces de alto rendimiento</strong
            >, código limpio y una experiencia de usuario optimizada de
            principio a fin.
         </p>

         <footer
            class="pt-4 border-t border-black/5 dark:border-white/5 flex flex-wrap items-center justify-between gap-4"
         >
            <div class="flex items-center gap-x-2">
               <div class="relative flex h-2 w-2">
                  <div
                     class="animate-ping-slow absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                  >
                  </div>
                  <div
                     class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
                  >
                  </div>
               </div>
               <span
                  class="text-xs font-bold uppercase tracking-widest opacity-80"
               >
                  Disponible para nuevos proyectos
               </span>
            </div>

            <span
               class="text-xs font-bold uppercase tracking-widest opacity-80"
            >
               Buenos Aires, AR
            </span>
         </footer>
      </div>
   </div>

   <div class="md:w-1/3 relative group">
      <div
         class="h-full w-full overflow-hidden rounded-xl border border-black/5 dark:border-border-subtle shadow-sm bg-bg-deep/5"
      >
         <Image
            src={profilePic}
            alt={personalImageAlt}
            class="w-full h-full object-cover"
         />
      </div>
   </div>
</div>

<style>
   @keyframes slow-ping {
      0% {
         transform: scale(1);
         opacity: 1;
      }
      /* El ping termina al 30% del tiempo total */
      20%,
      100% {
         transform: scale(2);
         opacity: 0;
      }
   }

   .animate-ping-slow {
      animation: slow-ping 3s cubic-bezier(0, 0, 0.2, 1) infinite;
   }
</style>
