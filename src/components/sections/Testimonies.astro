---
import Subtitle from "@shared/Subtitle.astro";
import StarIcon from "@icons/Star.astro"; // Asegurate de tener un icono de estrella
import { Image } from "astro:assets";

// Reutilizamos las mismas imágenes para mantener coherencia visual de marca
import imageJorgelina from "@assets/project-jorgelinareales.webp";
import imageAny from "@assets/project-anygiraldez.webp";
import imageIsabel from "@assets/project-isabellopez.webp";

const TESTIMONIALS = [
   {
      name: "Jorgelina Reales",
      role: "Fundadora de La Flor Sagrada",
      content:
         "¡Qué emoción ver mi página terminada! Santiago logró un resultado impecable; me encantó el diseño y cómo resaltan los colores. Lo que más me da paz mental es saber que ahora, cuando alguien me busque, mi web aparece entre las primeras y carga enseguida. Gracias por la paciencia para traducir mi identidad mística en una plataforma profesional. ¡Súper recomendado!",
      image: imageJorgelina,
      highlight: "Velocidad y SEO",
   },
   //    {
   //       name: "Any Giraldez",
   //       role: "Estilista de TV & Moda",
   //       content:
   //          "Buscaba una estética editorial y profesional. El resultado superó mis expectativas: una plataforma boutique, rápida y que proyecta exactamente la exclusividad de mi trabajo.",
   //       image: imageAny,
   //       highlight: "Diseño Premium",
   //    },
   {
      name: "Isabel López",
      role: "Coach Ontológica",
      content:
         "Lo que más destaco de trabajar con Santiago es que supo comprenderme desde el primer momento y plantear de manera visual y narrativa exactamente lo que quería transmitir. Me encanta cómo se ven los colores y lo profesional que quedó todo. Y sobre todo, me dio la tranquilidad de saber que mi web funciona muy bien y carga enseguida.",
      image: imageIsabel,
      highlight: "Conversión Real",
   },
];
---

<Subtitle class="flex items-center gap-x-4">
   <div class="sm:size-8 size-7 text-border-strong dark:text-text-highlighted">
      <StarIcon class="w-full h-full" />
   </div>
   <span>Testimonios</span>
</Subtitle>

<div id="testimonials-container" class="grid grid-cols-1 md:grid-cols-2 gap-6">
   {
      TESTIMONIALS.map(({ name, role, content, image, highlight }) => (
         <article class="testimonial-item opacity-0 flex flex-col p-8 rounded-2xl bg-white/80 dark:bg-bg-surface/40 border border-black/5 dark:border-border-subtle shadow-sm transition-[border-color,background-color] duration-500 hover:border-border-strong/20 dark:hover:border-text-highlighted/30">
            {/* <div class="flex items-center gap-x-1 mb-4 text-text-highlighted">
               {[...Array(5)].map(() => (
                  <StarIcon class="size-3 fill-current" />
               ))}
            </div> */}

            <p class="text-base leading-relaxed text-border-strong dark:text-text mb-8 flex-grow font-light">
               "{content}"
            </p>

            <footer class="flex items-center gap-x-4 pt-6 border-t border-black/[0.03] dark:border-white/[0.05]">
               {/* <div class="size-10 rounded-full overflow-hidden border border-black/10 dark:border-white/10">
                  <Image
                     src={image}
                     alt={`Retrato de ${name}`}
                     class="w-full h-full object-cover"
                     width={80}
                     height={80}
                  />
               </div> */}
               <div class="flex flex-col">
                  <span class="text-sm font-bold text-bg-deep dark:text-title tracking-tight">
                     {name}
                  </span>
                  <span class="text-[10px] uppercase tracking-widest text-text-muted/90 dark:text-text-highlighted font-medium">
                     {role}
                  </span>
               </div>
            </footer>
         </article>
      ))
   }
</div>

<script>
   import { animate, stagger, inView } from "motion";
   const threshold = window.innerWidth >= 640 ? 0.05 : 0.02;

   inView(
      "#testimonials-container",
      () => {
         animate(
            ".testimonial-item",
            {
               opacity: [0, 1],
               y: [15, 0],
            },
            {
               delay: stagger(0.1),
               duration: 0.3,
               easing: [0.22, 1, 0.36, 1],
            },
         );
      },
      { amount: threshold },
   );
</script>
