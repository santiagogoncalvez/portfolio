---
import { Image } from "astro:assets";
import Subtitle from "@shared/Subtitle.astro";
import imageLanding from "@assets/services/web-boutique-estilista-moda-any-giraldez.webp";
import imageInstitutional from "@assets/services/identidad-digital-marca-personal-jorgelina-reales.webp";
import imageCMS from "@assets/services/nidotrama-ecommerce-editorial-catalogo.webp";
import { variants } from "@/constants/cardVariants";
const SERVICES = [
   {
      title: "Landing Pages de Alta Conversión",
      description:
         "Sitios diseñados para una sola misión: vender. Utilizo tecnología de última generación para que tu web cargue al instante, evitando que pierdas clientes por esperas innecesarias.",
      image: imageLanding,
      alt: "Landing page diseñada para conversión",
   },
   {
      title: "Sitios Institucionales Premium",
      description:
         "Tu marca merece una presencia digital que proyecte confianza. Desarrollo sitios multi-sección con navegación fluida para marcas que buscan destacar y consolidar su imagen profesional.",
      image: imageInstitutional,
      alt: "Sitio institucional con diseño editorial",
   },
   {
      title: "Plataformas Autogestionables",
      description:
         "Olvidate de las plantillas limitadas. Creo sistemas a medida donde podés gestionar tu contenido de forma fácil, segura y sin depender de un programador.",
      image: imageCMS,
      alt: "Plataforma web con contenido autogestionable",
   },
];
---

<div id="services-container" class="grid grid-cols-1 md:grid-cols-3 gap-8">
   {
      SERVICES.map(({ title, description, image, alt }) => (
         <article class="service-item opacity-0 group">
            {" "}
            <div
               class={`overflow-hidden rounded-2xl transition-all duration-300 h-full ${variants.highlight}`}
            >
               {" "}
               <div class="aspect-video overflow-hidden">
                  {" "}
                  <Image
                     src={image}
                     alt={alt}
                     width={564}
                     height={317}
                     widths={[400, 564, 660]}
                     sizes="(max-width: 767px) 90vw, 564px"
                     format="webp"
                     quality={85}
                     loading="lazy"
                     decoding="async"
                     class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
                  />{" "}
               </div>{" "}
               <div class="p-6 sm:p-8">
                  {" "}
                  <h3 class="text-xl font-medium tracking-tight text-bg-elevated dark:text-title">
                     {" "}
                     {title}{" "}
                  </h3>{" "}
                  <p class="mt-4 text-sm leading-relaxed text-border-strong dark:text-text">
                     {" "}
                     {description}{" "}
                  </p>{" "}
               </div>{" "}
            </div>{" "}
         </article>
      ))
   }
</div>
<script>
   import { animate, stagger, inView } from "motion";
   const threshold = window.innerWidth >= 640 ? 0.05 : 0.02;
   inView(
      "#services-container",
      () => {
         animate(
            ".service-item",
            { opacity: [0, 1], y: [15, 0] },
            { delay: stagger(0.06), duration: 0.3, ease: [0.33, 1, 0.68, 1] },
         );
      },
      { amount: threshold },
   );
</script>
