---
import GitHub from "@icons/GitHub.astro";
import ExternalLink from "@icons/ExternalLink.astro";
import Code from "@icons/Code.astro";
import Subtitle from "@shared/Subtitle.astro";
import { Image } from "astro:assets";

import imageIsabelLopez from "@assets/projects/landing-page-conversion-coach-ontologica-isabel-lopez.webp";
import imageAnyGiraldez from "@assets/projects/web-boutique-estilista-moda-any-giraldez.webp";
import imageJorgelinaReales from "@assets/projects/identidad-digital-marca-personal-jorgelina-reales.webp";
import imageNidotrama from "@assets/projects/nidotrama-ecommerce-editorial.webp";

import videoIsabelLopez from "@assets/projects/videos/landing-page-conversion-coach-ontologica-isabel-lopez.mp4";
import videoAnyGiraldez from "@assets/projects/videos/web-boutique-estilista-moda-any-giraldez.mp4";
import videoJorgelinaReales from "@assets/projects/videos/identidad-digital-marca-personal-jorgelina-reales.mp4";
import videoNidotrama from "@assets/projects/videos/nidotrama-ecommerce-editorial.mp4";

import CtaButtonInner from "@/components/shared/CtaButtonInner.astro";

const PROJECTS = [
   {
      title: "E-commerce editorial - Nidotrama",
      description:
         "Desarrollo de una tienda online moderna para una marca textil con enfoque editorial. El proyecto combina una experiencia de compra fluida, alto rendimiento y un sistema de carrito compartible pensado para facilitar consultas y mejorar la conversión desde cualquier dispositivo.",
      link: "https://nidotrama.com",
      github: "",
      image: imageNidotrama,
      video: videoNidotrama,
      tags: ["Diseño Premium", "Alta Velocidad", "Posicionamiento Google"],
   },
   {
      title: "Identidad digital - Jorgelina Reales",
      description:
         "Transformación de una marca personal mística en una plataforma digital de alto nivel. Logramos un posicionamiento orgánico en los primeros resultados de Google y una velocidad de carga instantánea que permite conectar con la audiencia sin esperas desde el primer segundo.",
      link: "https://jorgelinareales.com.ar",
      github: "",
      image: imageJorgelinaReales,
      video: videoJorgelinaReales,
      tags: ["Diseño Premium", "Alta Velocidad", "Posicionamiento Google"],
   },
   {
      title: "Web boutique - Estilista de TV",
      description:
         "Creación de una plataforma con estética editorial para el sector de moda. El proyecto equilibra un diseño visual impactante con una navegación fluida, garantizando que la identidad de la marca brille con profesionalismo y elegancia en cualquier dispositivo.",
      link: "https://anygiraldez.com",
      github: "",
      image: imageAnyGiraldez,
      video: videoAnyGiraldez,
      tags: [
         "Diseño Editorial",
         "Experiencia de Usuario",
         "Optimización Móvil",
      ],
   },
   {
      title: "Landing de alta conversión - Coach Ontológica",
      description:
         "Desarrollo de una página enfocada 100% en captación de clientes. Diseñé una interfaz que proyecta autoridad y confianza, integrando canales de contacto directos para transformar las visitas en consultas reales de forma simple y efectiva.",
      link: "https://isabellopez.com.ar",
      github: "",
      image: imageIsabelLopez,
      video: videoIsabelLopez,
      tags: ["Ventas Online", "Marca Personal", "Fácil Contacto"],
   },
];
---

<div class="flex flex-row justify-between items-end flex-wrap gap-4">
   <Subtitle class="flex items-center gap-x-4 group">
      <!-- <Code
         class="sm:size-8 size-7 text-border-strong dark:text-text-highlighted"
      /> -->
      <span class="tracking-tight">Proyectos</span>
   </Subtitle>
   <p class="text-border-strong dark:text-text">Trabajos que hablan solos</p>
</div>

<div class="flex flex-col gap-y-8">
   {
      PROJECTS.map(({ image, video, title, description, link, github }) => (
         <article class=" project-item opacity-0 flex flex-col md:flex-row gap-8 bg-transparent dark:bg-transparent  dark:hover:border-text-highlighted/30 hover:border-border-strong/20 transition-colors duration-300 rounded-2xl group">
            {/* Columna Imagen */}
            <div class="w-full md:w-1/2 flex items-center justify-center">
               <div class="w-full rounded-2xl overflow-hidden  border-border-card-outline dark:border-border-strong/80 transform transition-transform duration-500 ease-out">
                  {/* <div class="h-6 bg-white/80 dark:bg-[#252525]  border-border-card-outline dark:border-border-strong/80 flex items-center px-3 gap-1.5">
                     <div class="size-2 rounded-full bg-border-card-outline dark:bg-border-strong/80" />
                     <div class="size-2 rounded-full bg-border-card-outline dark:bg-border-strong/80" />
                  </div> */}
                  <div class="aspect-video overflow-hidden relative">
                     <Image
                        src={image}
                        alt={`Captura de pantalla del proyecto ${title}`}
                        widths={[400, 564, 660]}
                        sizes={`(max-width: 767px) 90vw, 564px, 660px`}
                        width={564}
                        height={317}
                        format="webp"
                        quality={85}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-auto object-cover object-top bg-white dark:bg-white/[0.03]"
                     />

                     <video
                        src={video}
                        muted
                        loop
                        playsinline
                        preload="none"
                        class="project-video absolute inset-0 w-full h-full object-cover object-top opacity-0 transition-opacity duration-300"
                     />
                  </div>
               </div>
            </div>

            {/* Columna Contenido */}
            <div class="w-full md:w-1/2 flex flex-col justify-center">
               <h3 class="lg:text-2xl text-xl font-semibold text-bg-elevated dark:text-gray-100 mb-4">
                  {title}
               </h3>

               {/* <div class="mb-4">
                     <TechnologyPills techs={tags} />
               </div> */}

               <p class="text-border-strong dark:text-text leading-relaxed">
                  {description}
               </p>

               <footer class="flex items-center gap-x-4 mt-8 dark:border-border-strong/20">
                  {github && (
                     <CtaButtonInner
                        class="md:text-base text-base"
                        href={github}
                        target="_blank"
                        ariaLabel={`Ver repositorio del proyecto ${title}`}
                     >
                        <GitHub class="sm:size-5 size-4" />
                        <span>Código</span>
                     </CtaButtonInner>
                  )}

                  {link && (
                     <CtaButtonInner
                        class="md:text-base text-base"
                        href={link}
                        target="_blank"
                        ariaLabel={`Visitar sitio web del proyecto ${title}`}
                     >
                        <span>Visitar sitio</span>
                        <ExternalLink class="sm:size-5 size-4" />
                     </CtaButtonInner>
                  )}
               </footer>
            </div>
         </article>
      ))
   }
</div>

<script>
   import { animate, inView } from "motion";

   const threshold = window.innerWidth >= 640 ? 0.05 : 0.03;

   const items = document.querySelectorAll(".project-item");

   // Animación de entrada de cada proyecto
   items.forEach((item) => {
      inView(
         item,
         () => {
            animate(
               item,
               {
                  opacity: [0, 1],
                  y: [20, 0],
               },
               {
                  duration: 0.4,
                  ease: [0.22, 1, 0.36, 1],
               },
            );
         },
         { amount: threshold },
      );
   });

   let activeItem: Element | null = null;

   // Videos
   const updateActiveVideo = () => {
      const viewportCenter = window.innerHeight / 2;

      let closestItem: Element | null = null;
      let closestDistance = Infinity;

      items.forEach((item) => {
         const rect = item.getBoundingClientRect();

         // Solo consideramos proyectos que estén dentro del viewport
         if (rect.bottom > 0 && rect.top < window.innerHeight) {
            const itemCenter = rect.top + rect.height / 2;
            const distance = Math.abs(itemCenter - viewportCenter);

            if (distance < closestDistance) {
               closestDistance = distance;
               closestItem = item;
            }
         }
      });

      // Si el elemento activo no cambió, no hacemos nada
      if (closestItem === activeItem) {
         return;
      }

      // Pausamos todos los videos y volvemos a mostrar la imagen
      items.forEach((item) => {
         const video = item.querySelector(".project-video");

         if (video instanceof HTMLVideoElement && item !== closestItem) {
            video.pause();
            video.currentTime = 0;
            video.classList.remove("opacity-100");
         }
      });

      // Reproducimos solamente el nuevo elemento activo
      if (closestItem) {
         const video = closestItem.querySelector(".project-video");

         if (video instanceof HTMLVideoElement) {
            video.currentTime = 0;
            video.classList.add("opacity-100");
            video.play();
         }
      }

      // Guardamos el nuevo elemento activo
      activeItem = closestItem;
   };

   let ticking = false;

   const handleScroll = () => {
      if (!ticking) {
         window.requestAnimationFrame(() => {
            updateActiveVideo();
            ticking = false;
         });

         ticking = true;
      }
   };

   window.addEventListener("scroll", handleScroll, { passive: true });
   window.addEventListener("resize", updateActiveVideo);

   // Comprobar cuál corresponde al cargar
   updateActiveVideo();
</script>
