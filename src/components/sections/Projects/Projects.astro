---
import GitHub from "@icons/GitHub.astro";
import ExternalLink from "@icons/ExternalLink.astro";
import LinkButton from "./LinkButton.astro";
import TechnologyPills from "./TechnologyPills.astro";
import Code from "@icons/Code.astro";
import Subtitle from "@shared/Subtitle.astro";
import { Image } from "astro:assets";

import imageCrud from "@assets/project-core-crud-interface.webp";
import imageHakcerStories from "@assets/project-hacker-stories.webp";
import imageTestTypeScript from "@assets/project-typescript-test-with-react-query.webp";
import imageTuPais from "@assets/project-tu-pais.webp";
import imageIsabelLopez from "@assets/project-isabellopez.webp";

const IMAGES: Record<string, ImageMetadata> = {
   "/project-typescript-test-with-react-query.webp": imageTestTypeScript,
   "/project-hacker-stories.webp": imageHakcerStories,
   "/project-core-crud-interface.webp": imageCrud,
   "/project-tu-pais.webp": imageTuPais,
   "/project-isabel-lopez.webp": imageIsabelLopez,
};

const PROJECTS = [
   {
      title: "Plataforma de Identidad Digital — Coach Ontológica",
      description:
         "Diseño y desarrollo de una landing page de alta conversión para marca personal. Optimicé la velocidad de carga para reducir la tasa de rebote y desarrollé una interfaz que proyecta autoridad y confianza, integrando canales de contacto directo para maximizar la captación de clientes.",
      link: "https://isabellopez.com.ar",
      github: "",
      image: "/project-isabel-lopez.webp",
      tags: ["Astro", "Tailwind", "UI/UX", "SEO"],
   },
   {
      title: "Data Management Dashboard",
      description:
         "Panel de administración inteligente para la gestión de usuarios. Desarrollé herramientas de filtrado avanzado y organización de datos en tiempo real, optimizando el tiempo de respuesta del sistema y garantizando que la información esté siempre sincronizada y accesible.",
      link: "https://userops-dashboard.web.app",
      github:
         "https://github.com/santiagogoncalvez/midudevs-react-course/tree/main/projects/11b-typescript-prueba-tecnica-with-reacty-query",
      image: "/project-typescript-test-with-react-query.webp",
      tags: ["typescript", "React", "ReactQuery", "vite"],
   },
   {
      title: "Hacker Stories",
      description:
         "Aplicación de noticias en tiempo real diseñada para ofrecer una navegación fluida y sin esperas. Implementé carga infinita de contenido y guardado de datos local, asegurando una experiencia estable. Todo el sistema está respaldado por pruebas automatizadas para garantizar que la plataforma funcione siempre a la perfección.",
      link: "https://hackerstories-dev.web.app",
      github: "https://github.com/santiagogoncalvez/hacker-stories",
      image: "/project-hacker-stories.webp",
      tags: [
         "typescript",
         "React",
         "Vitest",
         "ReactQuery",
         "ReactRouter",
         "vite",
      ],
   },
];
---

<Subtitle class="flex items-center gap-x-4 group">
   <Code
      class="sm:size-8 size-7 text-border-strong dark:text-text-highlighted"
   />
   <span class="tracking-tight">Proyectos</span>
</Subtitle>

<div class="flex flex-col gap-y-12">
   {
      PROJECTS.map(
         ({ image, title, description, tags, link, github }, index) => (
            <article class="project-item opacity-0 flex flex-col md:flex-row bg-white/80 dark:bg-transparent border border-black/5 dark:border-border-subtle rounded-lg overflow-hidden shadow-sm hover:shadow-md group transition-[box-shadow,background-color] duration-500 ease-out">
               {/* Columna Imagen */}
               <div class="w-full md:w-5/12 flex items-center justify-center p-6 bg-gradient-to-br from-bg-deep/5 to-transparent dark:from-white/5">
                  <div class="w-full rounded-lg overflow-hidden border border-border-strong/10 dark:border-white/10 transform md:group-hover:-translate-y-1 transition-transform duration-500 ease-out">
                     <div class="h-6 bg-white/80 dark:bg-[#252525] border-b border-black/5 dark:border-white/5 flex items-center px-3 gap-1.5">
                        <div class="size-2 rounded-full bg-border-strong/20 dark:bg-white/10" />
                        <div class="size-2 rounded-full bg-border-strong/20 dark:bg-white/10" />
                     </div>
                     <div class="aspect-video overflow-hidden">
                        <Image
                           src={IMAGES[image]}
                           alt={`Captura de pantalla del proyecto ${title}`}
                           widths={[400, 800, 1200]}
                           sizes={`(max-width: 768px) 95vw, 500px`}
                           width={700}
                           height={392}
                           format="webp"
                           quality={80}
                           loading={index === 0 ? "eager" : "lazy"}
                           decoding={index === 0 ? "sync" : "async"}
                           fetchpriority={index === 0 ? "high" : "low"}
                           class="w-full h-full object-cover object-top"
                        />
                     </div>
                  </div>
               </div>

               {/* Columna Contenido */}
               <div class="w-full md:w-7/12 p-6 md:p-8 flex flex-col justify-center">
                  <h3 class="lg:text-2xl text-xl font-bold text-bg-deep dark:text-gray-100 mb-3">
                     {title}
                  </h3>
                  <div class="mb-4">
                     <TechnologyPills techs={tags} />
                  </div>
                  <p class="text-border-strong dark:text-text flex-grow leading-relaxed">
                     {description}
                  </p>
                  <footer class="flex items-center gap-x-4 mt-6 pt-4 border-t border-black/5 dark:border-white/5">
                     {github && (
                        <LinkButton href={github} variant="secondary">
                           <GitHub class="sm:size-5 size-4" />
                           <span>Código</span>
                        </LinkButton>
                     )}
                     {link && (
                        <LinkButton
                           href={link}
                           ariaLabel={`Ver sitio web del proyecto ${title}`}
                        >
                           <span>Ver sitio</span>
                           <ExternalLink class="sm:size-5 size-4" />
                        </LinkButton>
                     )}
                  </footer>
               </div>
            </article>
         ),
      )
   }
</div>

<script>
   import { animate, stagger, inView } from "motion";

   const threshold = window.innerWidth >= 640 ? 0.05 : 0.03;

   // Seleccionamos todos los elementos individualmente
   const items = document.querySelectorAll(".project-item");

   items.forEach((item) => {
      inView(
         item,
         (info) => {
            // La animación se dispara solo para 'item' cuando entra en pantalla
            animate(
               item,
               {
                  opacity: [0, 1],
                  y: [20, 0],
               },
               {
                  duration: 0.35,
                  easing: [0.22, 1, 0.36, 1],
               },
            );

            // Opcional: Si solo quieres que se anime la primera vez que se ve
            // return () => { /* limpieza o dejar vacío para que no se repita */ };
         },
         { amount: threshold },
      ); // Ajusta el threshold según necesites
   });
</script>
