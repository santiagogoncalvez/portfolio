---
import GitHub from "@icons/GitHub.astro";
import ExternalLink from "@icons/ExternalLink.astro";
import Code from "@icons/Code.astro";
import Subtitle from "@shared/Subtitle.astro";
import { Image } from "astro:assets";

import imageIsabelLopez from "@assets/projects/landing-page-conversion-coach-ontologica-isabel-lopez.webp";
import imageAnyGiraldez from "@assets/projects/web-boutique-estilista-moda-any-giraldez.webp";
import imageJorgelinaReales from "@assets/projects/identidad-digital-marca-personal-jorgelina-reales.webp";
import CtaButtonInner from "@/components/shared/CtaButtonInner.astro";

const PROJECTS = [
   {
      title: "Identidad Digital - Jorgelina Reales",
      description:
         "Transformación de una marca personal mística en una plataforma digital de alto nivel. Logramos un posicionamiento orgánico en los primeros resultados de Google y una velocidad de carga instantánea que permite conectar con la audiencia sin esperas desde el primer segundo.",
      link: "https://jorgelinareales.com.ar",
      github: "",
      image: imageJorgelinaReales,
      tags: ["Diseño Premium", "Alta Velocidad", "Posicionamiento Google"],
   },
   {
      title: "Web Boutique - Estilista de TV",
      description:
         "Creación de una plataforma con estética editorial para el sector de moda. El proyecto equilibra un diseño visual impactante con una navegación fluida, garantizando que la identidad de la marca brille con profesionalismo y elegancia en cualquier dispositivo.",
      link: "https://anygiraldez.com",
      github: "",
      image: imageAnyGiraldez,
      tags: [
         "Diseño Editorial",
         "Experiencia de Usuario",
         "Optimización Móvil",
      ],
   },
   {
      title: "Landing de Alta Conversión - Coach Ontológica",
      description:
         "Desarrollo de una página enfocada 100% en captación de clientes. Diseñé una interfaz que proyecta autoridad y confianza, integrando canales de contacto directos para transformar las visitas en consultas reales de forma simple y efectiva.",
      link: "https://isabellopez.com.ar",
      github: "",
      image: imageIsabelLopez,
      tags: ["Ventas Online", "Marca Personal", "Fácil Contacto"],
   },
];
---

<Subtitle class="flex items-center gap-x-4 group">
   <Code
      class="sm:size-8 size-7 text-border-strong dark:text-text-highlighted"
   />
   <span class="tracking-tight">Proyectos</span>
</Subtitle>

<div class="flex flex-col gap-y-12">
   {
      PROJECTS.map(
         ({ image, title, description, tags, link, github }, index) => (
            <article class="overflow-hidden project-item opacity-0 flex flex-col md:flex-row bg-white/40 dark:bg-transparent hover:bg-border-card-outline/15  dark:hover:bg-white/2 dark:hover:border-text-highlighted/30 hover:border-border-strong/20 transition-colors duration-300 rounded-2xl group">
               {/* Columna Imagen */}
               <div class="w-full md:w-5/12 flex items-center justify-center p-6 bg-gradient-to-br from-bg-deep/5 to-transparent dark:from-white/5">
                  <div class="w-full rounded-2xl overflow-hidden border border-border-strong/10 dark:border-white/10 transform md:group-hover:-translate-y-1 transition-transform duration-500 ease-out">
                     <div class="h-6 bg-white/80 dark:bg-[#252525] border-b border-border-card-outline dark:border-white/5 flex items-center px-3 gap-1.5">
                        <div class="size-2 rounded-full bg-border-strong/20 dark:bg-white/10" />
                        <div class="size-2 rounded-full bg-border-strong/20 dark:bg-white/10" />
                     </div>
                     <div class="aspect-video overflow-hidden">
                        <Image
                           src={image}
                           alt={`Captura de pantalla del proyecto ${title}`}
                           widths={[400, 564, 660]}
                           sizes={`(max-width: 767px) 90vw, 564px, 660px`}
                           width={564}
                           height={317}
                           format="webp"
                           quality={95}
                           loading="lazy"
                           decoding="async"
                           class="w-full h-auto object-cover object-top"
                        />
                     </div>
                  </div>
               </div>

               {/* Columna Contenido */}
               <div class="w-full md:w-7/12 p-6 md:p-8 flex flex-col justify-center">
                  <h3 class="lg:text-2xl text-xl font-bold text-bg-elevated dark:text-gray-100 mb-4">
                     {title}
                  </h3>
                  {/* <div class="mb-4">
                     <TechnologyPills techs={tags} />
                  </div> */}
                  <p class="text-border-strong dark:text-text flex-grow leading-relaxed">
                     {description}
                  </p>
                  <footer class="flex items-center gap-x-4 mt-8 dark:border-border-strong/20">
                     {github && (
                        <CtaButtonInner
                           class="md:text-base text-base"
                           href={github}
                           target="_blank"
                           ariaLabel={`Ver repositorio del proyecto ${title}`}
                        >
                           <GitHub class="sm:size-5 size-4" />
                           <span>Código</span>
                        </CtaButtonInner>
                     )}
                     {link && (
                        <CtaButtonInner
                           class="md:text-base text-base"
                           href={link}
                           target="_blank"
                           ariaLabel={`Visitar sitio web del proyecto ${title}`}
                        >
                           <span>Visitar sitio</span>
                           <ExternalLink class="sm:size-5 size-4" />
                        </CtaButtonInner>
                     )}
                  </footer>
               </div>
            </article>
         ),
      )
   }
</div>

<script>
   import { animate, stagger, inView } from "motion";

   const threshold = window.innerWidth >= 640 ? 0.05 : 0.03;

   // Seleccionamos todos los elementos individualmente
   const items = document.querySelectorAll(".project-item");

   items.forEach((item) => {
      inView(
         item,
         (info) => {
            // La animación se dispara solo para 'item' cuando entra en pantalla
            animate(
               item,
               {
                  opacity: [0, 1],
                  y: [20, 0],
               },
               {
                  duration: 0.4,
                  easing: [0.22, 1, 0.36, 1],
               },
            );

            // Opcional: Si solo quieres que se anime la primera vez que se ve
            // return () => { /* limpieza o dejar vacío para que no se repita */ };
         },
         { amount: threshold },
      ); // Ajusta el threshold según necesites
   });
</script>
