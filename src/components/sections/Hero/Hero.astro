---
import ProfilePhoto from "./ProfilePhoto.astro";
import PrincipalTitle from "@shared/PrincipalTitle.astro";
import HeroDescription from "./HeroDescription.astro";
import HeroNav from "./HeroNav.astro";
---

<div class="w-full flex flex-row items-center justify-center gap-6">
   <div class="w-full flex items-center flex-col sm:gap-8 gap-6">
      <div class="animate-item relative opacity-0">
            <ProfilePhoto
               class="sm:size-22 size-16 m-0"
               width={96}
               height={96}
               sizes="96px"
            />
         <div
            class="absolute md:-bottom-0 md:-right-0 -bottom-1
-right-1 bg-green-500 size-2 rounded-full"
         >
         </div>
      </div>

      <div class="flex flex-col sm:gap-6 gap-4 items-center">
         <div class="animate-item opacity-0">
            <PrincipalTitle />
         </div>

         <div class="animate-item opacity-0">
            <HeroDescription />
         </div>
      </div>

      <div class="animate-item w-full opacity-0">
         <HeroNav />
      </div>
   </div>
</div>

<script>
   import { animate, stagger } from "motion";

   // Motion One prefiere selectores directos o arrays de elementos del DOM
   // Usar el selector de clase es lo más eficiente
   animate(
      ".animate-item",
      {
         opacity: [0, 1],
         y: [12, 0],
      },
      {
         delay: stagger(0.05), // Esto ahora aplicará el retraso a cada elemento con esa clase
         duration: 0.3,
         easing: [0.22, 1, 0.36, 1],
      },
   );
</script>
