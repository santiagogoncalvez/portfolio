---
import ProfilePhoto from "./ProfilePhoto.astro";
import PrincipalTitle from "@shared/PrincipalTitle.astro";
import HeroDescription from "./HeroDescription.astro";
import HeroNav from "./HeroNav.astro";
---

<div class="w-full flex flex-row items-center justify-content gap-6">
   <div class="w-full flex items-center flex-col sm:gap-8 gap-6">
      <div class="relative">
         <ProfilePhoto
            class="sm:size-22 size-20 rounded-full border-2 border-black/5 dark:border-white/1 p-1"
            width={96}
            height={96}
            sizes="96px"
         />
         <div
            class="absolute -bottom-1 -right-1 bg-green-500 size-4 rounded-full border-2 border-white dark:border-[#0a0a0a]"
         >
         </div>
      </div>

      <div class="flex flex-col gap-10 items-center">
         <PrincipalTitle />
         <HeroDescription />
      </div>

      <HeroNav />
   </div>
</div>
