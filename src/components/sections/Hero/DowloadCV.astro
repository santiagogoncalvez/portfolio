---
import DownloadIcon from "@icons/Dowload.astro";
import ExternalLinkIcon from "@icons/ExternalLink.astro";

const { class: className } = Astro.props;

// 1. Ruta para descarga (local/relativa)
const CV_URL_LOCAL = "/Santiago-Goncalvez-CV.pdf";

// 2. Ruta para el visor (debe ser absoluta y pública)
const CV_URL_ABSOLUTE =
   "https://santiagogoncalvez.com/Santiago-Goncalvez-CV.pdf";

// 3. Generamos la URL del visor directamente
const GOOGLE_VIEWER_URL = `https://docs.google.com/viewer?url=${encodeURIComponent(CV_URL_ABSOLUTE)}&embedded=true`;

// Nota: En desktop podrías preferir CV_URL_LOCAL, en mobile GOOGLE_VIEWER_URL.
// Por ahora, usemos el visor por defecto para asegurar que funcione en móvil.
---

<div class={`flex flex-wrap items-center gap-3 ${className ?? ""}`}>
   <a
      id="cv-view-link"
      href={GOOGLE_VIEWER_URL}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
         "group relative inline-flex items-center justify-center gap-x-2",
         "py-2.5 px-6 rounded-full overflow-hidden transition-all duration-300",
         "border backdrop-blur-sm text-title dark:text-bg-base bg-bg-base dark:bg-title border-black/5 dark:border-white/10",
         "no-mobile-motion",
      ]}
   >
      <div
         class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 dark:via-border-strong/40 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-in-out"
      >
      </div>
      <span class="relative text-sm sm:text-base font-semibold tracking-wide"
         >Ver CV</span
      >
      <ExternalLinkIcon class="size-4 sm:size-5" />
   </a>

   <a
      href={CV_URL_LOCAL}
      download="Santiago-Goncalvez-CV.pdf"
      class="group inline-flex items-center py-2.5 px-4 gap-2 text-sm sm:text-base text-bg-elevated dark:text-text font-semibold hover:opacity-80 transition-opacity"
   >
      Descargar
      <DownloadIcon class="size-4 sm:size-5" />
   </a>
</div>

<script define:vars={{ CV_URL_LOCAL, GOOGLE_VIEWER_URL }}>
   // OPCIONAL: Si quieres que en PC use el visor nativo y en móvil el de Google
   const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
   const link = document.getElementById("cv-view-link");

   if (!isMobile && link) {
      link.href = CV_URL_LOCAL;
   }
</script>
