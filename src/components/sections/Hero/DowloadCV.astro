---
import DownloadIcon from "@icons/Dowload.astro"; // Ojo, revisa si es "Download" con 'n'
import ExternalLinkIcon from "@icons/ExternalLink.astro";

const { class: className } = Astro.props;

// Cambia esto por tu URL real cuando lo subas (ej: https://tudominio.com/archivo.pdf)
const CV_URL = "/Santiago-Goncalvez-CV.pdf";
const CV_URL_ABSOLUTE =
   "https://santiagogoncalvez.web.app/Santiago-Goncalvez-CV.pdf";

// Esta es la URL para el visor de Google (solo funciona con URLs absolutas https://)
// Si estás en local (localhost), esto no funcionará, así que usamos un condicional
const isExternal = CV_URL.startsWith("http");
const VIEW_URL = isExternal
   ? `https://docs.google.com/viewer?url=${encodeURIComponent(CV_URL_ABSOLUTE)}&embedded=true`
   : CV_URL;
---

<div class={`flex flex-wrap items-center gap-3 ${className ?? ""}`}>
   <a
      href={VIEW_URL}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
         "group relative inline-flex items-center justify-center gap-x-2",
         "py-2.5 px-6 rounded-full overflow-hidden",
         "transition-all duration-300",
         "border backdrop-blur-sm",

         "text-title dark:text-bg-base",
         "bg-bg-base dark:bg-title border-black/5 dark:border-white/10",

         "hover:bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] hover:from-white/60 hover:to-bg-base",
         "dark:hover:bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] dark:hover:from-white dark:hover:to-bg-surface",

         "no-mobile-motion",
      ]}
   >
      <div
         class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 dark:via-border-strong/40 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-in-out flex items-center justify-center"
      >
      </div>

      <span class="relative text-sm sm:text-base font-semibold tracking-wide">
         Ver CV
      </span>

      <ExternalLinkIcon class="size-4 sm:size-5" />
   </a>

   <a
      href={CV_URL}
      download="Santiago-Goncalvez-CV.pdf"
      class="group inline-flex items-center py-2.5 px-4 gap-2 text-sm sm:text-base text-bg-elevated dark:text-text font-semibold hover:opacity-80 transition-opacity"
   >
      Descargar
      <DownloadIcon class="size-4 sm:size-5" />
   </a>
</div>
