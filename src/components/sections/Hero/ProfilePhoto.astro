---
import { Image } from "astro:assets";
import profilePic from "@assets/santiago-goncalvez-estratega-digital-react-astro.webp";

const {
   width = 500,
   height = 500,
   sizes = "(max-width: 768px) 150px, 500px",
   class: extraClass = "",
} = Astro.props;
---

<div
   class={`order-1 shrink-0 rounded-full
         /* Sombra Light: Centrada y suave */
         shadow-[0_0_30px_rgba(0,0,0,0.08)]
         /* Sombra Dark: Centrada con un leve brillo sutil */
         dark:shadow-[0_0_50px_rgba(0,0,0,0.8),0_0_20px_rgba(255,255,255,0.03)]
         
         transition-all duration-500 ease-out
         
         /* Hover Light: Se expande parejo hacia todos lados */
         hover:scale-103 hover:shadow-[0_0_40px_rgba(0,0,0,0.12)]
         /* Hover Dark: Brillo más intenso pero siempre sin desplazamiento */
         dark:hover:shadow-[0_0_60px_rgba(0,0,0,0.5),0_0_30px_rgba(255,255,255,0.05)]
         
         ${extraClass}`}
>
   <Image
      src={profilePic}
      alt="Retrato de Santiago Goncalvez - Desarrollador Web"
      width={width}
      height={height}
      widths={[150, 300, 500, 800]}
      sizes={sizes}
      format="webp"
      quality={80}
      fetchpriority="high"
      loading="eager"
      decoding="sync"
      class="rounded-full object-cover w-full h-auto bg-[#faf9f9] dark:bg-text-muted"
   />
</div>
