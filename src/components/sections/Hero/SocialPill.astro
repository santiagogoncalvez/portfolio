---
const {
  copyText,
  class: className = "",
  ...rest
} = Astro.props;
---

<div class="flex items-center flex-wrap gap-3 text-border-strong dark:text-text">
  <a
    class={`rounded-full border border-transparent flex items-center gap-x-2
      transition
      ${className}`}
    target="_blank"
    rel="noopener noreferrer"
    {...rest}
  >
    <slot />
  </a>

  {copyText && (
    <button
      type="button"
      data-copy-button
      data-copy={copyText}
      class="text-sm w-20 py-1 text-center  rounded-md border border-border-card-outline dark:border-border-strong/80 font-medium
             text-border-strong dark:text-text
             hover:text-gray-900 dark:hover:text-gray-200
             hover:cursor-pointer
             transition
             focus:outline-none focus-visible:underline"
      aria-live="polite"
    >
      Copiar
    </button>
  )}
</div>

{copyText && (
  <script>
  const copyBtn = document.querySelector('[data-copy-button]') as HTMLElement | null;

  if (copyBtn) {
    const originalText = 'Copiar';
    const copiedText = 'Copiado';
    const copyValue = copyBtn.dataset.copy; // Ahora esto no dará error

    copyBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      if (!copyValue) return;

      try {
        await navigator.clipboard.writeText(copyValue);
        copyBtn.textContent = copiedText;

        navigator.vibrate?.(25);

        setTimeout(() => {
          copyBtn.textContent = originalText;
        }, 1500);
      } catch (err) {
        console.error('Error al copiar:', err);
      }
    });
  }
</script>
)}


<style>
  [data-copy-button][data-copied] .copy-icon {
    opacity: 0;
    /* transform: scale(0.90); */
  }

  [data-copy-button][data-copied] .check-icon {
    opacity: 1;
    /* transform: scale(1); */
  }
</style>
