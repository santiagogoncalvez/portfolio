---
import SocialPill from "../sections/Hero/SocialPill.astro";
import LogoSG from "./LogoSG.astro";
import LinkedInIcon from "@icons/LinkedIn.astro";
import GitHubIcon from "@icons/GitHub.astro";
import MailIcon from "@icons/Mail.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { instagram, whatsappWithoutMessage } from "@/constants/contact.mjs";
import WhatsApp from "@/icons/WhatsApp.astro";
import Instagram from "@/icons/Instagram.astro";

const currentYear = new Date().getFullYear();

import { navItems } from "@/constants/navItems.mjs";
---

<footer
   id="footer"
   class="opacity-98 sm:my-12 my-8 min-w-full flex justify-center px-5"
>
   <div
      class="w-full mx-auto lg:max-w-5xl flex flex-col items-center justify-between gap-y-20 flex-wrap rounded-2xl"
   >
      <div
         class="w-full flex sm:flex-row flex-col sm:justify-between justify-center gap-12"
      >
         <div class="flex flex-col gap-4 text-border-strong dark:text-text">
            <LogoSG />
         </div>

         <div class="flex gap-x-25 gap-y-15 flex-wrap">
            <div class="flex flex-col gap-4">
               <p class="text-border-strong dark:text-title font-medium">
                  Portafolio
               </p>
               <ul
                  class="flex flex-col gap-3 text-border-strong dark:text-text"
               >
                  {
                     navItems.map((item) => (
                        <li>
                           <a
                              class="hover:text-bg-deep dark:hover:text-title transition-colors ease-in-out me-4 md:me-6"
                              aria-label={item.label}
                              href={item.url}
                           >
                              {item.title}
                           </a>
                        </li>
                     ))
                  }
               </ul>
            </div>

            <div class="flex flex-col gap-4">
               <p class="text-border-strong dark:text-title font-medium">
                  Contacto
               </p>
               <ul class="flex flex-col gap-3">
                  <li>
                     <SocialPill
                        href={whatsappWithoutMessage}
                        aria-label="WhatsApp de Santiago Goncalvez"
                        class="hover:text-bg-deep dark:hover:text-title transition-colors ease-in-out"
                     >
                        <WhatsApp class="size-4" />
                        <span>WhatsApp</span>
                     </SocialPill>
                  </li>
                  <li>
                     <SocialPill
                        href="mailto:santiago.goncalvez.dev@gmail.com"
                        aria-label="Correo electrónico de Santiago Goncalvez"
                        class="hover:text-bg-deep dark:hover:text-title transition-colors ease-in-out"
                        copyText="santiago.goncalvez.dev@gmail.com"
                     >
                        <MailIcon class="size-4" />
                        <span>Email</span>
                     </SocialPill>
                  </li>
                  <li>
                     <SocialPill
                        href="https://www.linkedin.com/in/santiagogoncalvez"
                        aria-label="Perfil de LinkedIn de Santiago Goncalvez"
                        class="hover:text-bg-deep dark:hover:text-title transition-colors ease-in-out"
                     >
                        <LinkedInIcon class="size-4" />
                        <span>LinkedIn</span>
                     </SocialPill>
                  </li>

                  <!-- <li>
                     <SocialPill
                        href="https://github.com/santiagogoncalvez"
                        aria-label="Perfil de GitHub de Santiago Goncalvez"
                        class="hover:text-bg-deep dark:hover:text-title transition-colors ease-in-out"
                     >
                        <GitHubIcon class="size-4" />
                        <span>GitHub</span>
                     </SocialPill>
                  </li> -->
                  <!-- <li>
                     <SocialPill
                        href={instagram}
                        aria-label="Perfil de GitHub de Santiago Goncalvez"
                        class="hover:text-bg-deep dark:hover:text-title transition-colors ease-in-out"
                     >
                        <Instagram class="size-4" />
                        <span>Instagram</span>
                     </SocialPill>
                  </li> -->
               </ul>
            </div>
         </div>
      </div>

      <div
         class="w-full flex justify-between gap-10 items-center text-border-strong dark:text-text"
      >
         <p>
            &copy; {currentYear} Santiago Goncalvez. Todos los derechos reservados.
         </p>

         <ThemeToggle id="theme-desktop" position="up" />
      </div>
   </div>
</footer>
