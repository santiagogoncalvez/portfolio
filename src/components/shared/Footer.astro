---
import SocialPill from "../sections/Hero/SocialPill.astro";
import LogoSG from "./LogoSG.astro";
import LinkedInIcon from "@icons/LinkedIn.astro";
import GitHubIcon from "@icons/GitHub.astro";
import MailIcon from "@icons/Mail.astro";

const currentYear = new Date().getFullYear();
---

<footer
   id="footer"
   class="opacity-98 mt-24 mb-24 min-w-full flex justify-center px-5"
>
   <div
      class="w-full mx-auto lg:max-w-5xl flex flex-col items-center justify-between gap-y-4 flex-wrap rounded-lg"
   >
      <div
         class="w-full flex sm:flex-row flex-col flex-col-reverse sm:justify-between justify-center gap-15"
      >
         <div class="flex flex-col gap-4 text-border-strong dark:text-text">
            <LogoSG />

            <a
               href="https://www.linkedin.com/in/santiagogoncalvez"
               target="_blank"
               class="inline-flex items-center gap-2 w-fit
         rounded-md px-2 py-2
          select-none
         hover:bg-text-light/60
         dark:hover:bg-bg-surface
         transition-colors"
            >
               <span
                  class="h-2 w-2 shrink-0 rounded-full bg-green-500
           ring-2 ring-green-500/20
           dark:ring-green-500/30"
                  aria-hidden="true"></span>

               <span>Disponible para nuevos proyectos</span>
            </a>

            <span
               >&copy; {currentYear}
               <a
                  href="https://www.linkedin.com/in/santiagogoncalvez"
                  target="_blank"
                  class="hover:underline">Santiago Goncalvez</a
               >.
            </span>
         </div>

         <div class="flex gap-x-25 gap-y-15 flex-wrap">
            <div class="flex flex-col gap-4">
               <h2 class="text-border-strong dark:text-title font-medium">
                  Porfolio
               </h2>
               <ul
                  class="flex flex-col gap-3 text-border-strong dark:text-text"
               >
                  <!-- <li>
                     <a href="/#top" class="hover:underline me-4 md:me-6"
                        >Inicio</a
                     >
                  </li> -->
                  <li>
                     <a href="/#soluciones" class="hover:underline me-4 md:me-6"
                        >Soluciones</a
                     >
                  </li>
                  <li>
                     <a href="/#proyectos" class="hover:underline me-4 md:me-6"
                        >Proyectos</a
                     >
                  </li>
                  <li>
                     <a href="/#sobre-mi" class="hover:underline me-4 md:me-6"
                        >Sobre mí</a
                     >
                  </li>
                  <li>
                     <a href="/#formacion" class="hover:underline me-4 md:me-6"
                        >Formación</a
                     >
                  </li>
                  <li>
                     <a href="/#contacto" class="hover:underline me-4 md:me-6"
                        >Contacto</a
                     >
                  </li>
               </ul>
            </div>

            <div class="flex flex-col gap-4">
               <h2 class="text-border-strong dark:text-title font-medium">
                  Contacto
               </h2>
               <ul class="flex flex-col gap-3">
                  <li>
                     <SocialPill
                        href="https://www.linkedin.com/in/santiagogoncalvez"
                        aria-label="Perfil de LinkedIn de Santiago Goncalvez"
                     >
                        <LinkedInIcon class="size-3 sm:size-4" />
                        <span>LinkedIn</span>
                     </SocialPill>
                  </li>

                  <li>
                     <SocialPill
                        href="https://github.com/santiagogoncalvez"
                        aria-label="Perfil de GitHub de Santiago Goncalvez"
                     >
                        <GitHubIcon class="size-3 sm:size-4" />
                        <span>GitHub</span>
                     </SocialPill>
                  </li>

                  <li>
                     <SocialPill
                        href="mailto:santiago.goncalvez.dev@gmail.com"
                        aria-label="Correo electrónico de Santiago Goncalvez"
                        copyText="santiago.goncalvez.dev@gmail.com"
                     >
                        <MailIcon class="size-3 sm:size-4" />
                        <span>Email</span>
                     </SocialPill>
                  </li>
               </ul>
            </div>
         </div>
      </div>
   </div>
</footer>
