---
import SunIcon from "@icons/Sun.astro";
import MoonIcon from "@icons/Moon.astro";
import SystemIcon from "@icons/System.astro";

// Añadimos 'position' a las props, por defecto 'down'
interface Props {
   id?: string;
   position?: "up" | "down";
}

const { id, position = "down" } = Astro.props;
const THEMES = ["Claro", "Oscuro", "Sistema"];

// Definimos dinámicamente la clase de posición y el origen de la animación
const positionClasses =
   position === "up" ? "bottom-12 origin-bottom" : "top-10 origin-top";
---

<div class="relative theme-toggle-container" data-theme-root={id}>
   <button
      aria-haspopup="menu"
      class="flex items-center justify-center h-9 min-w-9 px-2 hover:cursor-pointer rounded-md border bg-transparent dark:bg-transparent border-text-light dark:border-border-strong transition"
      data-theme-btn
   >
      <span class="sr-only">Elegir tema</span>
      <div class="relative w-5 h-5">
         <div class="absolute inset-0" data-icon="claro">
            <SunIcon class="w-full h-full stroke-bg-base dark:stroke-title" />
         </div>
         <div class="absolute inset-0" data-icon="oscuro">
            <MoonIcon class="w-full h-full stroke-bg-base dark:stroke-title" />
         </div>
         <div class="absolute inset-0" data-icon="sistema">
            <SystemIcon
               class="w-full h-full stroke-bg-base dark:stroke-title"
            />
         </div>
      </div>
   </button>

   <div
      class:list={[
         "absolute hidden right-0 min-w-[9rem] p-1 rounded-md border bg-[var(--color-bg-white)] border-text-light shadow-lg dark:bg-[var(--color-bg-elevated)] dark:border-[var(--color-border-subtle)] z-30",
         positionClasses,
      ]}
      data-theme-menu
   >
      <ul class="flex flex-col">
         {
            THEMES.map((theme) => (
               <li
                  class="px-2 py-1.5 rounded-sm cursor-pointer text-border-strong hover:bg-black/5 hover:text-bg-deep dark:hover:text-text-light dark:text-text dark:hover:bg-white/5 transition-colors"
                  data-theme={theme.toLowerCase()}
               >
                  {theme}
               </li>
            ))
         }
      </ul>
   </div>
</div>

<style>
   /* Mantenemos tus estilos, solo ajustamos la animación para que use el origin definido arriba */
   [data-icon] {
      opacity: 0;
      transform: scale(0.85);
      transition:
         opacity 0.2s ease,
         transform 0.2s ease;
      pointer-events: none;
   }
   [data-icon].active {
      opacity: 1;
      transform: scale(1);
   }
   [data-theme-menu].open {
      display: block;
      animation: scale-up 0.12s ease-out both;
   }
   @keyframes scale-up {
      from {
         /* Usamos scale(0.96) para que no sea tan brusco */
         transform: scale(0.96);
         opacity: 0;
      }
      to {
         transform: scale(1);
         opacity: 1;
      }
   }
</style>

<script>
   // Esta función maneja la lógica visual de TODOS los componentes a la vez
   const updateAllToggles = () => {
      const theme = localStorage.getItem("theme") || "sistema";
      const isDark =
         theme === "oscuro" ||
         (theme === "sistema" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);

      document.documentElement.classList.toggle("dark", isDark);

      // Actualizamos los iconos en todas las instancias (Desktop y Mobile)
      document
         .querySelectorAll(".theme-toggle-container")
         .forEach((container) => {
            const icons = container.querySelectorAll("[data-icon]");
            icons.forEach((icon) => {
               icon.classList.toggle("active", icon.dataset.icon === theme);
            });
         });
   };

   // Inicializamos cada componente de forma independiente para sus eventos de clic
   const setupToggles = () => {
      const containers = document.querySelectorAll(".theme-toggle-container");

      containers.forEach((container) => {
         const btn = container.querySelector("[data-theme-btn]");
         const menu = container.querySelector("[data-theme-menu]");

         btn.addEventListener("click", (e) => {
            e.stopPropagation();
            // Cerramos otros menús antes de abrir este
            document.querySelectorAll("[data-theme-menu]").forEach((m) => {
               if (m !== menu) m.classList.remove("open");
            });
            menu.classList.toggle("open");
         });

         menu.addEventListener("click", (e) => {
            const option = e.target.closest("[data-theme]");
            if (!option) return;

            localStorage.setItem("theme", option.dataset.theme);
            updateAllToggles();
            menu.classList.remove("open");
         });
      });

      // Cerrar menús al hacer clic fuera
      document.addEventListener("click", () => {
         document
            .querySelectorAll("[data-theme-menu]")
            .forEach((m) => m.classList.remove("open"));
      });
   };

   // Ejecutar en la carga inicial
   setupToggles();
   updateAllToggles();

   // Escuchar cambios de preferencia del sistema (opcional pero recomendado)
   window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", updateAllToggles);

   // Si usas ViewTransitions de Astro, añade esto:
   // document.addEventListener('astro:after-swap', () => { setupToggles(); updateAllToggles(); });
</script>
