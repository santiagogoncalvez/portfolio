---
import { whatsappUrl } from "@/constants/contact.mjs";
---

<a
   href={whatsappUrl}
   target="_blank"
   rel="noopener noreferrer"
   class=`flex items-center justify-center gap-2
              text-base
              font-medium
              px-3 py-1.5
              
              text-title dark:text-bg-base
              bg-bg-base dark:bg-title
              border
              border-text-light
              dark:border-border-strong
              transition ${Astro.props.class}`
>
   <slot />
</a>
