---
// CtaButton.astro
import {
   whatsappUrlprojectMessage,
   whatsappUrlchatMessage,
} from "@/constants/contact.mjs";

interface Props {
   class?: string;
   isChatIntent?: boolean; // Cambiado de isCharla
}

const { class: className, isChatIntent = false } = Astro.props;

const url = isChatIntent ? whatsappUrlchatMessage : whatsappUrlprojectMessage;
---

<a
   href={url}
   target="_blank"
   rel="noopener noreferrer"
   class=`flex items-center justify-center gap-2
          font-semibold
          px-3 py-1.5

          rounded-full
          
          /* Colores base */
          text-white dark:text-bg-deep
          bg-bg-deep dark:bg-white
          border border-black/10 dark:border-white/10
          
          /* HOVER: Elevación + Glow */
          transition-all duration-300 ease-out
          hover:-translate-y-0.5
          active:scale-95
          ${Astro.props.class}`
>
   <slot />
</a>
