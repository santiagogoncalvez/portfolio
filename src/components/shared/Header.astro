---
import LogoSG from "./LogoSG.astro";
import ThemeToggle from "./ThemeToggle.astro";

import SocialPill from "../sections/Hero/SocialPill.astro";
import LinkedInIcon from "@icons/LinkedIn.astro";
import GitHubIcon from "@icons/GitHub.astro";
import Menu from "@icons/Menu.astro";
import Close from "@icons/Close.astro";
import CtaButton from "./CtaButton.astro";

const navItems = [
   { title: "Soluciones", label: "soluciones", url: "/#soluciones" },
   { title: "Proyectos", label: "proyectos", url: "/#proyectos" },
   { title: "Sobre mí", label: "sobre-mi", url: "/#sobre-mi" },
   { title: "Formación", label: "formacion", url: "/#formacion" },
   { title: "Contacto", label: "contacto", url: "/#contacto" },
];
---

<header
   id="header"
   class="fixed top-0 inset-x-0 z-10
         transition-colors duration-300
         border-b border-transparent"
>
   <div class="mx-auto max-w-6xl px-5">
      <nav
         class="flex items-center justify-between py-4
             w-full mx-auto lg:max-w-5xl"
      >
         <!-- ================= DESKTOP ================= -->
         <div class="hidden lg:flex w-full items-center justify-between">
            <div class="flex gap-8">
               <LogoSG />

               <div class="flex items-center">
                  {
                     navItems.map((link) => (
                        <a
                           class="nav-link relative
                    sm:px-3.5 px-2 sm:py-1 py-0.5 rounded-full
                    text-sm sm:text-base font-[500]
                    transition-colors duration-300"
                           aria-label={link.label}
                           href={link.url}
                        >
                           {link.title}
                        </a>
                     ))
                  }
               </div>
            </div>

            <div class="flex gap-2 items-center">
               <SocialPill
                  href="https://www.linkedin.com/in/santiagogoncalvez"
                  aria-label="Perfil de LinkedIn de Santiago Goncalvez"
                  class="p-1.5 transition-all rounded-lg hover:bg-black/[0.05] dark:hover:bg-white/[0.05] group"
               >
                  <LinkedInIcon
                     class="size-6 text-border-strong/90 dark:text-text group-hover:text-black dark:group-hover:text-white transition-colors"
                  />
               </SocialPill>

               <!-- <SocialPill
                  href="https://github.com/santiagogoncalvez"
                  aria-label="Perfil de GitHub de Santiago Goncalvez"
                  class="p-1.5 transition-all rounded-lg hover:bg-black/[0.05] dark:hover:bg-white/[0.05] group"
               >
                  <GitHubIcon
                     class="size-6 text-border-strong/90 dark:text-text group-hover:text-black dark:group-hover:text-white transition-colors"
                  />
               </SocialPill> -->

               <!-- <ThemeToggle id="theme-desktop" /> -->

               <CtaButton class="rounded-md">Trabajemos juntos</CtaButton>
            </div>
         </div>

         <!-- ================= MOBILE ================= -->
         <div class="flex lg:hidden w-full items-center justify-between">
            <LogoSG />

            <button
               id="mobile-menu-btn"
               aria-label="Abrir menú"
               class="h-9 w-9 hover:cursor-pointer flex items-center justify-center
                 rounded-md
                 border border-text-light
                 dark:border-border-strong text-bg-base dark:text-title"
            >
               <Menu class="size-5" />
            </button>
         </div>
      </nav>
   </div>

   <!-- ================= MOBILE MENU ================= -->
   <div
      id="mobile-menu"
      class="lg:hidden fixed inset-0 z-20 hidden
           dark:bg-bg-base bg-title"
   >
      <div
         class="flex items-center justify-between px-5 py-4
             border-b border-text-light
             dark:border-border-strong"
      >
         <LogoSG />

         <button
            id="mobile-menu-close"
            aria-label="Cerrar menú"
            class="h-9 w-9 hover:cursor-pointer flex items-center justify-center rounded-md"
         >
            <Close class="size-5 text-bg-base dark:text-title" />
         </button>
      </div>

      <div class="flex flex-col gap-8 p-4">
         <!-- <div class="w-full px-3.5"> -->
            <CtaButton class="w-full rounded-md">Trabajemos juntos</CtaButton>
         <!-- </div> -->

         <div class="flex flex-col gap-4">
            {
               navItems.map((link) => (
                  <a
                     class="w-fit nav-link relative
                    px-3.5 py-1 rounded-full
                    text-base font-[500]
                    transition-colors duration-300"
                     aria-label={link.label}
                     href={link.url}
                  >
                     {link.title}
                  </a>
               ))
            }
         </div>

         <div class="w-full">
            <div
               class="min-w-full flex h-[1px] bg-border-card-outline dark:bg-border-strong/80"
            >
            </div>
         </div>

         <div class="flex flex-col gap-4">
            <div
               class="w-full flex justify-between text-border-strong dark:text-text"
            >
               <span>Tema</span>
               <ThemeToggle id="theme-mobile" />
            </div>

            <div class="w-full flex gap-2 items-center justify-center">
               <SocialPill
                  href="https://www.linkedin.com/in/santiagogoncalvez"
                  aria-label="Perfil de LinkedIn de Santiago Goncalvez"
                  class="p-1.5 transition-all rounded-lg hover:bg-black/[0.05] dark:hover:bg-white/[0.05] group"
               >
                  <LinkedInIcon
                     class="size-6 text-border-strong/90 dark:text-text group-hover:text-black dark:group-hover:text-white transition-colors"
                  />
               </SocialPill>

               <!-- <SocialPill
                  href="https://github.com/santiagogoncalvez"
                  aria-label="Perfil de GitHub de Santiago Goncalvez"
                  class="p-1.5 transition-all rounded-lg hover:bg-black/[0.05] dark:hover:bg-white/[0.05] group"
               >
                  <GitHubIcon
                     class="size-6 text-border-strong/90 dark:text-text group-hover:text-black dark:group-hover:text-white transition-colors"
                  />
               </SocialPill> -->
            </div>
         </div>
      </div>
   </div>
</header>

<script>
   const lockScroll = (): void => {
      document.documentElement.style.overflow = "hidden";
   };

   const unlockScroll = (): void => {
      document.documentElement.style.overflow = "";
   };

   const initNavScroll = (): void => {
      const header = document.getElementById("header");
      if (!header) return;

      // Se especifica HTMLElement para acceder a .offsetTop
      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      const links = document.querySelectorAll<HTMLElement>(".nav-link");
      const root = document.documentElement;
      const OFFSET = 120;

      // Tipado del parámetro str como string
      const normalize = (str: string): string =>
         str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");

      const resetHeader = (): void => {
         header.classList.remove(
            "bg-title",
            "bg-bg-base",
            "border-border-card-outline",
            "border-white/10",
         );
         header.classList.add("border-transparent");
      };

      const applyHeaderState = (): void => {
         const isDark = root.classList.contains("dark");
         const y = window.scrollY;

         resetHeader();

         if (y > 0) {
            header.classList.remove("border-transparent");
            header.classList.add(
               isDark ? "bg-bg-base" : "bg-title",
               isDark ? "border-white/10" : "border-border-card-outline",
            );
         }
      };

      // Tipado del parámetro id como string
      const setActiveLink = (id: string): void => {
         const isDark = root.classList.contains("dark");

         links.forEach((link) => {
            const label = normalize(link.getAttribute("aria-label") || "");

            link.classList.remove(
               "bg-text-light",
               "bg-border-light",
               "text-white",
               "text-text",
               "text-border-strong/90",
               "text-bg-base",
            );

            link.classList.add(isDark ? "text-text" : "text-border-strong/90");

            if (label === id && id !== "") {
               link.classList.remove("text-text", "text-border-strong/90");
               link.classList.add(
                  isDark ? "bg-border-light" : "bg-text-light",
                  isDark ? "text-white" : "text-bg-base",
               );
            }
         });
      };

      const updateActiveSection = (): void => {
         const y = window.scrollY;

         if (y < 100) {
            setActiveLink("");
            return;
         }

         let current = "";
         sections.forEach((section) => {
            if (y + OFFSET >= section.offsetTop) {
               current = normalize(section.id);
            }
         });

         setActiveLink(current);
      };

      const update = (): void => {
         applyHeaderState();
         updateActiveSection();
      };

      window.addEventListener("scroll", update, { passive: true });

      const observer = new MutationObserver(update);
      observer.observe(root, {
         attributes: true,
         attributeFilter: ["class"],
      });

      update();
   };

   const initMobileMenu = (): void => {
      const menu = document.getElementById("mobile-menu");
      const openBtn = document.getElementById("mobile-menu-btn");
      const closeBtn = document.getElementById("mobile-menu-close");

      if (!menu || !openBtn || !closeBtn) return;

      const closeMenu = (): void => {
         menu.classList.add("hidden");
         unlockScroll();
      };

      openBtn.addEventListener("click", () => {
         menu.classList.remove("hidden");
         lockScroll();
         window.dispatchEvent(new Event("theme-sync"));
      });

      closeBtn.addEventListener("click", closeMenu);

      menu.querySelectorAll("a[href^='/#'], a[href^='#']").forEach((link) => {
         link.addEventListener("click", closeMenu);
      });
   };

   document.addEventListener("DOMContentLoaded", () => {
      initNavScroll();
      initMobileMenu();
   });

   document.addEventListener("astro:after-swap", () => {
      initNavScroll();
      initMobileMenu();
   });
</script>
