---
import LogoSG from "./LogoSG.astro";
import ThemeToggle from "./ThemeToggle.astro";

import SocialPill from "../sections/Hero/SocialPill.astro";
import LinkedInIcon from "@icons/LinkedIn.astro";
import GitHubIcon from "@icons/GitHub.astro";
import MailIcon from "@icons/Mail.astro";

const navItems = [
   { title: "Proyectos", label: "proyectos", url: "/#proyectos" },
   { title: "Sobre mí", label: "sobre-mi", url: "/#sobre-mi" },
   { title: "Formación", label: "formacion", url: "/#formacion" },
   // {
   //    title: "Contacto",
   //    label: "contacto",
   //    url: "mailto:santiago.goncalvez.dev@gmail.com",
   // },
];
---

<header
   id="header"
   class="fixed top-0 inset-x-0 z-10
         transition-colors duration-300
         border-b border-transparent"
>
   <div class="mx-auto max-w-6xl sm:px-5 px-0.5">
      <nav
         class="flex items-center justify-between py-4
             w-full mx-auto lg:w-[900px]"
      >
         <div class="flex gap-8">
            <LogoSG />

            <div class="sm:hidden inline"></div>

            <div class="flex items-center">
               {
                  navItems.map((link) => (
                     <a
                        class="nav-link relative
   sm:px-3.5 px-2 sm:py-1 py-0.5 rounded-full
   text-sm sm:text-base font-[500] 
   transition-colors duration-300"
                        aria-label={link.label}
                        href={link.url}
                     >
                        {link.title}
                     </a>
                  ))
               }
            </div>
         </div>

         <div class="flex gap-2 items-center">
            <SocialPill
               href="https://www.linkedin.com/in/santiagogoncalvez"
               aria-label="Perfil de LinkedIn de Santiago Goncalvez"
               class="p-2"
            >
               <LinkedInIcon class="size-4 sm:size-5.5 text-border-strong/90 dark:text-text" />
            </SocialPill>

            <SocialPill
               href="https://github.com/santiagogoncalvez"
               aria-label="Perfil de GitHub de Santiago Goncalvez"
               class="p-2"
            >
               <GitHubIcon class="size-4 sm:size-5.5 text-border-strong/90 dark:text-text" />
            </SocialPill>

            <!-- <SocialPill
               href="mailto:santiago.goncalvez.dev@gmail.com"
               aria-label="Correo electrónico de Santiago Goncalvez"
               class="p-2"
               copyText
            >
               <MailIcon class="size-5 sm:size-6" />
               
            </SocialPill> -->

            <ThemeToggle />

            <a
               href="#footer"
               class="flex items-center justify-center
               text-sm sm:text-base
      sm:h-9 sm:min-w-9 h-7
      sm:px-3 px-1
      rounded-lg
      text-title dark:text-bg-base
bg-bg-base dark:bg-title
      font-semibold
      border
      border-text-light
      dark:border-border-strong
      hover:cursor-pointer
      transition
      focus-visible:outline-none
      focus-visible:ring-2
      focus-visible:ring-[var(--color-border-strong)]"
            >
               Contactar
            </a>
         </div>
      </nav>
   </div>
</header>

<script>
   const initNavScroll = () => {
      const header = document.getElementById("header") as HTMLElement | null;
      if (!header) return;

      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      const links = document.querySelectorAll<HTMLElement>(".nav-link");
      const root = document.documentElement;

      const OFFSET: number = 120;

      const normalize = (str: string): string =>
         str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");

      const resetHeader = (): void => {
         header.classList.remove(
            "bg-title",
            "bg-bg-base",
            "border-black/10",
            "border-white/10",
         );

         // 🔑 estado inicial real
         header.classList.add("border-transparent");
      };

      const applyHeaderState = (): void => {
         const isDark: boolean = root.classList.contains("dark");
         const y: number = window.scrollY;

         // 🔥 Reset total
         resetHeader();

         // 🟢 Solo aparece fondo + borde después del primer scroll
         if (y > 0) {
            header.classList.remove("border-transparent");

            if (isDark) {
               header.classList.add("bg-bg-base", "border-white/10");
            } else {
               header.classList.add("bg-title", "border-black/10");
            }
         }
      };

      const setActiveLink = (id: string): void => {
         const isDark = root.classList.contains("dark");

         links.forEach((link) => {
            const label = normalize(link.getAttribute("aria-label") ?? "");

            // 🔥 RESET TOTAL (acá estaba el problema)
            link.classList.remove(
               "bg-text-light",
               "bg-border-light",
               "text-white",
               "text-text",
               "text-border-strong/90",
               "text-bg-base",
            );

            // 🟡 Estado base (no activo)
            if (isDark) {
               link.classList.add("text-text");
            } else {
               link.classList.add("text-border-strong/90");
            }

            // 🟢 Estado activo (tipo Vercel)
            if (label === id && id !== "") {
               // Fondo suave en ambos modos
               link.classList.remove("text-text");
               link.classList.remove("text-border-strong/90");

               if (isDark) {
                  link.classList.add("bg-border-light");
               } else {
                  link.classList.add("bg-text-light");
               }

               // Texto SOLO cambia en dark
               if (isDark) {
                  link.classList.add("text-white");
               } else {
                  link.classList.add("text-bg-base");
               }
            }
         });
      };

      const updateActiveSection = (): void => {
         const y: number = window.scrollY;

         if (y < 100) {
            setActiveLink("");
            return;
         }

         let current: string = "";

         sections.forEach((section) => {
            if (y + OFFSET >= section.offsetTop) {
               current = normalize(section.id);
            }
         });

         setActiveLink(current);
      };

      const update = (): void => {
         applyHeaderState();
         updateActiveSection();
      };

      // Scroll
      window.addEventListener("scroll", update, { passive: true });

      // Cambio de theme
      const observer = new MutationObserver(() => update());
      observer.observe(root, {
         attributes: true,
         attributeFilter: ["class"],
      });

      update();
   };

   document.addEventListener("DOMContentLoaded", initNavScroll);
   document.addEventListener("astro:after-swap", initNavScroll);
</script>
