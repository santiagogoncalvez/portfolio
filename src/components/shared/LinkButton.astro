---
interface Props {
   href: string;
   variant?: "primary" | "secondary";
   class?: string;
   ariaLabel?: string;
}

const { href, variant = "primary", class: className, ariaLabel } = Astro.props;

// Definición de estilos basada en tu paleta premium
const variantStyles = {
   primary: `
    bg-bg-deep text-white border-transparent 
    hover:bg-bg-deep/90 hover:shadow-lg hover:shadow-bg-deep/10
    dark:bg-white dark:text-bg-deep dark:hover:bg-gray-200
  `,
   secondary: `
    bg-transparent text-border-strong border-border-strong/20 
    hover:border-border-strong/40 hover:bg-black/[0.02] hover:text-bg-deep
    dark:border-border-subtle dark:text-text dark:bg-bg-surface/50 
    dark:hover:border-text-highlighted/50 dark:hover:text-title dark:hover:bg-white/[0.02]
  `,
};
---

<a
   target="_blank"
   rel="noopener noreferrer"
   aria-label={ariaLabel}
   href={href}
   role="link"
   class={`
    inline-flex items-center justify-center gap-2 px-5 py-2.5 
    text-sm font-semibold transition-all duration-300
    border rounded-full focus:outline-none focus-visible:ring-2 
    focus-visible:ring-offset-2 focus-visible:ring-text-muted
    group max-w-fit cursor-pointer
    ${variantStyles[variant]}
    ${className}
  `}
>
   <slot />
</a>
