---
import Logo from "@/icons/Logo.astro";
import LogoDark from "@/icons/LogoDark.astro";

// Obtener la ruta actual
const { pathname } = Astro.url;

// Si la ruta es "/" (o "/index.html"), el link es "#top", de lo contrario es "/"
const href = pathname === "/" || pathname === "/index.html" ? "#top" : "/";
---

<a
   class="font-bold text-bg-base dark:text-title w-fit h-fit"
   aria-label="inicio"
   href={href}
>
   <Logo class="size-8 flex dark:hidden" />
   <LogoDark class="size-8 hidden dark:flex" />
</a>
